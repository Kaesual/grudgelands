   ],
   "reward_items": [],
   "title": "A Debt at Rainchar Camp",
   "turnin": "r20_anchor_048_host",
   "xp": 753
  },
  {
   "copper": 160,
   "description": "Bottle-Keeper Zek guards the witches' stolen storms in the Thunderroot Stormglades, southwest from here, with thunder in bottles and apes in the grass. Go by day and kill Zek along with four Treetop Jungle Apes in those glades. I want to hear the sky speak with its whole voice again.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_rainchar_03",
