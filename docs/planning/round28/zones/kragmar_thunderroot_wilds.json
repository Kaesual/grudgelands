   ],
   "reward_items": [],
   "title": "Zek Keeps the Wrong Company",
   "turnin": "r20_anchor_048_host",
   "xp": 1100
  },
  {
   "copper": 128,
   "description": "The Bog Witch Storm-Bottle waits in the Thunderroot Heartwood, west from here, clutching enough stolen thunder to make even the spirits keep their distance. Bring a group and kill her; no one should face that storm alone. Courage is easier to find with friends standing in the rain beside you.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_rainchar_group",
