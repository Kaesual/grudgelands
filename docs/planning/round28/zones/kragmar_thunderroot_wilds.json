 "quests": [
  {
   "copper": 112,
   "description": "The Treetop Jungle Apes in the Thunderroot Canopy, which lies in the northwest of Thunderroot Wilds, greet every scout with a chorus loud enough to guide an Accord patrol. Hunt them by day and kill four. I asked the spirits for silence; they sent more rain, which was thoughtful but unhelpful.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_storm_01",
   "min_level": 29,
   "objectives": [
    "kill 4 territorial_ape [in kragmar_thunderroot_wilds/canopy]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/canopy",
     "count": 4,
     "mobs": [
      "grug_mobs:territorial_ape"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "An Unhelpful Chorus",
   "turnin": "r20_anchor_048_host",
   "xp": 630
  },
  {
   "copper": 128,
   "description": "The Reed-Hex Bog Witches gather after dark in the Thunderroot Bogs, which lie in the north of Thunderroot Wilds, bottling thunder as though the sky were theirs to pickle. Kill four and bring me two Hex Bottle Shards; let us see whose storm they thought they could keep.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_storm_02",
   "min_level": 31,
   "objectives": [
    "kill 4 reed_hex_witch [in kragmar_thunderroot_wilds/bogs]",
    "bring 2 grug_mobs:hex_bottle_shard"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/bogs",
     "count": 4,
     "mobs": [
      "grug_mobs:reed_hex_witch"
     ],
     "type": "kill"
    },
    {
     "count": 2,
     "item": "grug_mobs:hex_bottle_shard",
     "type": "item"
    }
   ],
   "prerequisites": [
    "thunderroot_storm_01"
   ],
   "reward_items": [],
   "title": "Thunder Needs No Cork",
   "turnin": "r20_anchor_048_host",
   "xp": 740
  },
  {
   "copper": 48,
   "description": "Our drums carry through rain, but our allies at Ashveil Watch have only the ash wind for company. Find Vaska Ashlistener there on Blackwind Rise and offer your help. Roots hold together beneath the soil; so must the Throng, even where our branches cannot touch.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_storm_03",
   "min_level": 32,
   "objectives": [
    "talk to Vaska Ashlistener (r20_anchor_039)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_039_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "thunderroot_storm_02"
   ],
   "reward_items": [],
   "title": "Rain for the Ashes",
   "turnin": "r20_anchor_039_host",
   "xp": 285
  },
  {
   "copper": 112,
   "description": "The marsh speaks to those who listen, but lately our foragers hear nothing except hissing. Kill four Coiled Serpents basking by day in the Thunderroot Witchmire, which lies in the heart of Thunderroot Wilds. The spirits may teach patience; I would rather our foragers came home to learn it.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_rainchar_01",
   "min_level": 34,
   "objectives": [
    "kill 4 coiled_serpent [in kragmar_thunderroot_wilds/witchmire]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/witchmire",
     "count": 4,
     "mobs": [
      "grug_mobs:coiled_serpent"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Listen for the Hiss",
   "turnin": "r20_anchor_048_host",
   "xp": 718
  },
  {
   "copper": 112,
   "description": "A message wrapped in silk sounds grand until you learn the messenger is still inside. Kill four Canopy-Web Jungle Spiders after dark in the Thunderroot Deepwood, which lies in the heart of Thunderroot Wilds. Our words must reach the other outposts before the spiders finish reading them.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_storm_04",
   "min_level": 34,
   "objectives": [
    "kill 4 canopy_web_spider [in kragmar_thunderroot_wilds/deepwood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/deepwood",
     "count": 4,
     "mobs": [
      "grug_mobs:canopy_web_spider"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "thunderroot_storm_02"
   ],
   "reward_items": [],
   "title": "Messages Wrapped in Silk",
   "turnin": "r20_anchor_048_host",
   "xp": 700
  },
  {
   "copper": 64,
   "description": "The Treetop Jungle Apes have claimed the day's chorus in the Thunderroot Deepwood; even the birds sound offended. Kill six there by day and return for your reward. Wait twenty minutes after collecting before taking this bounty again; that gives me time to remember what a bird sounds like.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_storm_bounty",
   "min_level": 34,
   "objectives": [
    "kill 6 territorial_ape [in kragmar_thunderroot_wilds/deepwood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/deepwood",
     "count": 6,
     "mobs": [
      "grug_mobs:territorial_ape"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
