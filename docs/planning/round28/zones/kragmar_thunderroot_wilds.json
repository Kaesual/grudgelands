   ],
   "reward_items": [],
   "title": "Bounty: The Chorus Returns (repeatable)",
   "turnin": "r20_anchor_048_host",
   "xp": 410
  },
  {
   "copper": 112,
   "description": "The bandits at the Rainchar Camp southwest from here sell our stolen supplies while Thunderstep's fighters make do with scraps. Kill four Entrenched Bandit Archers there. Hungry fighters hold no line, whatever the spirits promise.",
   "giver": "r20_anchor_048_host",
   "giver_name": "Rumela Stormstep",
   "giver_settlement": "Thunderstep Watch",
   "id": "thunderroot_rainchar_02",
   "min_level": 37,
   "objectives": [
    "kill 4 entrenched_bandit_archer [in kragmar_thunderroot_wilds/rainchar_camp]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_thunderroot_wilds/rainchar_camp",
     "count": 4,
     "mobs": [
      "grug_mobs:entrenched_bandit_archer"
