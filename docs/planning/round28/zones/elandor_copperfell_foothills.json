   ],
   "reward_items": [],
   "title": "The Surveyor Has Tusks",
   "turnin": "r14_dwarf_steward",
   "xp": 320
  },
  {
   "copper": 16,
   "description": "Hear that clatter from the workyard? That's what a rail sounds like when its clamps have had enough. Bring me four Iron Bars and four Coal Lumps for replacements, and I'll give you an Iron Pickaxe for the harder rock below.",
   "giver": "r15_dwarf_local",
   "giver_name": "Dagna Copperset",
   "giver_settlement": "Copperfell Village",
   "id": "copperfell_workyard_01",
   "min_level": 10,
   "objectives": [
    "bring 4 grug_materials:iron_bar",
    "bring 4 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 4,
