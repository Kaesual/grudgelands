 "quests": [
  {
   "copper": 21,
   "description": "I paid a surveyor to mark our claims, and the Rooting Boars have submitted their own revisions. Kill eight of them by day in the Copperfell Lower Pines, which lie in the south of Copperfell Foothills. We cannot run a mine on measurements taken by snout.",
   "giver": "r14_dwarf_steward",
   "giver_name": "Orrik Pineledger",
   "giver_settlement": "Copperfell Village",
   "id": "copperfell_survey_01",
   "min_level": 9,
   "objectives": [
    "kill 8 young_boar [in elandor_copperfell_foothills/lower_pines]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_copperfell_foothills/lower_pines",
     "count": 8,
