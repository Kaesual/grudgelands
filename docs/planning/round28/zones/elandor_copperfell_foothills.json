   "xp": 170
  },
  {
   "copper": 13,
   "description": "Half the workyard is sharing one sound handle, and the other half is waiting to borrow it. Bring me three Ridged Boar Tusks from Rooting Boars in the Copperfell Lower Pines by day; any you saved will do. I'll see to the fitting, you see to the tusks.",
   "giver": "r15_dwarf_local",
   "giver_name": "Dagna Copperset",
   "giver_settlement": "Copperfell Village",
   "id": "copperfell_workyard_02",
