   ],
   "reward_items": [
    "grug_materials:pick_iron 1"
   ],
   "title": "Keep the Rails Together",
   "turnin": "r15_dwarf_local",
   "xp": 255
  },
  {
   "copper": 21,
   "description": "A Granary Rat ate six months of accounts last night and left the cover, which I consider criticism. Kill eight Granary Rats in the Copperfell Lower Pines after dark. Those books record what the miners are owed, and teeth are no excuse for missing wages.",
   "giver": "r14_dwarf_steward",
   "giver_name": "Orrik Pineledger",
   "giver_settlement": "Copperfell Village",
   "id": "copperfell_survey_02",
   "min_level": 11,
   "objectives": [
