   ],
   "reward_items": [],
   "title": "Spears Out, Word Back",
   "turnin": "r20_anchor_022_host",
   "xp": 203
  },
  {
   "copper": 19,
   "description": "Our troll allies send fish from Whisperreed Landing, and our salt makes the return journey. Go to Whispering Reedlands and speak to Taleko Drycord at the landing. Give our allies a hand; a shared cooking pot holds the Throng together as surely as any war banner.",
   "giver": "r20_orc_capital_cook",
   "giver_name": "Gorla Longladle",
   "giver_settlement": "Gor Drazhak",
   "id": "gor_drazhak_dispatch_02",
   "min_level": 22,
   "objectives": [
