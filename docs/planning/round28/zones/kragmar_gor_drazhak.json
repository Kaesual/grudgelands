   ],
   "reward_items": [],
   "title": "Salt Keeps a Friendship",
   "turnin": "r20_anchor_024_host",
   "xp": 210
  },
  {
   "copper": 51,
   "description": "Warriors can argue about who leads the march; at supper, every last one answers to my ladle. Bring me eight pieces of Raw Meat and two Braided Sinew from the Waterhole Zebras that graze the Gor Drazhak Badlands by day. We have ration bundles to tie and a hungry muster to fill them for.",
   "giver": "r20_orc_capital_cook",
   "giver_name": "Gorla Longladle",
   "giver_settlement": "Gor Drazhak",
   "id": "gor_drazhak_provisions_01",
   "min_level": 22,
   "objectives": [
