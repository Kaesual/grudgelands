 "quests": [
  {
   "copper": 58,
   "description": "Gor Drazhak's sentries should be watching for enemy banners, yet half their night goes to watching their ankles. Kill eight Dust-Stinger Scorpions after dark on the Gor Drazhak Steppe, near Gor Drazhak. The Throng needs its guards standing firm.",
   "giver": "r20_orc_capital_envoy",
   "giver_name": "Thorga Roadspeaker",
   "giver_settlement": "Gor Drazhak",
   "id": "gor_drazhak_muster_01",
   "min_level": 19,
   "objectives": [
    "kill 8 dust_stinger [in kragmar_gor_drazhak/steppe]"
   ],
   "objectives_raw": [
