   ],
   "reward_items": [],
   "title": "Waste Nothing With Stripes",
   "turnin": "r14_orc_steward",
   "xp": 320
  },
  {
   "copper": 16,
   "description": "The bowyers have a rack of unstrung bows and a fine collection of excuses. Bring me three Tough Sinew from the Waterhole Zebras that graze the Redtusk Grasslands by day. Then we can all listen to something besides complaining.",
   "giver": "r15_orc_local",
   "giver_name": "Morga Clayhand",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_hides_01",
   "min_level": 10,
   "objectives": [
    "bring 3 grug_mobs:tough_sinew"
   ],
   "objectives_raw": [
