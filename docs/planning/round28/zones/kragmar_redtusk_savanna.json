     "count": 3,
     "item": "grug_mobs:tough_sinew",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Give the Bows Their Voices",
   "turnin": "r15_orc_local",
   "xp": 255
  },
  {
   "copper": 21,
   "description": "A herder watching the herd should not have to watch both boots as well. Kill eight Dust-Stinger Scorpions in the Redtusk Grasslands after dark. I want our people coming home on their own feet.",
   "giver": "r14_orc_steward",
   "giver_name": "Borak Redgrass",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_herd_02",
   "min_level": 11,
   "objectives": [
    "kill 8 dust_stinger [in kragmar_redtusk_savanna/grasslands]"
   ],
