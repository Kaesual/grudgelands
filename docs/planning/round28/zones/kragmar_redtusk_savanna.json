 "quests": [
  {
   "copper": 21,
   "description": "Bring down eight Waterhole Zebras by day in the Redtusk Grasslands, in the north of Redtusk Savanna. Redtusk fills bellies and hide racks from the same hunt; waste any of it and the tanners will tan you instead.",
   "giver": "r14_orc_steward",
   "giver_name": "Borak Redgrass",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_herd_01",
   "min_level": 9,
   "objectives": [
    "kill 8 watchful_zebra [in kragmar_redtusk_savanna/grasslands]"
   ],
   "objectives_raw": [
