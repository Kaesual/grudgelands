   ],
   "reward_items": [],
   "title": "Keep It Out of the Stew",
   "turnin": "r15_orc_local",
   "xp": 270
  },
  {
   "copper": 23,
   "description": "I tied a pen shut last night and found the knot this morning, with precious little rope attached. Hunt the Dust Gnawers in the Redtusk Tallgrass, in the southwest of Redtusk Savanna, and kill eight after dark. Give them something worse than rope to bite.",
   "giver": "r14_orc_steward",
   "giver_name": "Borak Redgrass",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_herd_03",
   "min_level": 13,
   "objectives": [
