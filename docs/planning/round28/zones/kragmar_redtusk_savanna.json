   "title": "All Knot, No Rope",
   "turnin": "r14_orc_steward",
   "xp": 450
  },
  {
   "copper": 18,
   "description": "Our pen gate groans louder than the beasts behind it, and I know which one will give way first. Bring me six Iron Bars and four Coal Lumps so the smith can mend the hinges. I have spent enough mornings chasing our supper through the dust.",
   "giver": "r15_orc_local",
   "giver_name": "Morga Clayhand",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_stores_01",
