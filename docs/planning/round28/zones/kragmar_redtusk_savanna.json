   ],
   "prerequisites": [
    "redtusk_herd_01"
   ],
   "reward_items": [],
   "title": "Bring the Herders Home",
   "turnin": "r14_orc_steward",
   "xp": 340
  },
  {
   "copper": 16,
   "description": "The hunters want three Bitter Venom for their spears, and I have promised to keep the cooks well away from it. Gather it from Dust-Stinger Scorpions in the Redtusk Grasslands at night and bring it straight to me. Straight to me, even if somebody offers you a clean bowl.",
   "giver": "r15_orc_local",
   "giver_name": "Morga Clayhand",
   "giver_settlement": "Redtusk Village",
   "id": "redtusk_hides_02",
   "min_level": 12,
