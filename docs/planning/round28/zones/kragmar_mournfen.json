   ],
   "reward_items": [],
   "title": "A Flame Worth Keeping",
   "turnin": "r15_undead_local",
   "xp": 315
  },
  {
   "copper": 10,
   "description": "Each night the Grave Gnawers burrow into the Mournfen Barrowfields, undoing another day's careful burial work. Kill six and return to me. You may take this task again twenty minutes after handing it in; eternal rest has proved surprisingly demanding to maintain.",
   "giver": "r14_undead_steward",
   "giver_name": "Mordec Silt",
   "giver_settlement": "Mournfen Village",
   "id": "mournfen_bounty_fen",
