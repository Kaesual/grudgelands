   "reward_items": [],
   "title": "Repeatable: The Graves Need Minding (repeatable)",
   "turnin": "r14_undead_steward",
   "xp": 210
  },
  {
   "copper": 23,
   "description": "The Pauper Shamblers rise at night across the Mournfen Gravemoor east of Mournfen Village, with no one left to claim them. Lay six to rest. I shall enter each in the burial book, though I have only numbers to give them. A number is a poor memorial, but a blank page is worse.",
   "giver": "r14_undead_steward",
   "giver_name": "Mordec Silt",
   "giver_settlement": "Mournfen Village",
   "id": "mournfen_fen_04",
