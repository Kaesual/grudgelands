   ],
   "reward_items": [],
   "title": "Lanterns Belong Above the Mud",
   "turnin": "r15_undead_local",
   "xp": 300
  },
  {
   "copper": 16,
   "description": "Bring me three Wisp Motes from the Wandering Wisps that appear in the Mournfen Wispfen after dark. I need them for the vigil candles. When the last visitor leaves, I like there to be a little light left behind.",
   "giver": "r15_undead_local",
   "giver_name": "Edris Wax",
   "giver_settlement": "Mournfen Village",
   "id": "mournfen_wax_01",
   "min_level": 15,
   "objectives": [
