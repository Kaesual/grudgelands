     "type": "talk"
    }
   ],
   "prerequisites": [
    "durbrannoc_gate_01"
   ],
   "reward_items": [],
   "title": "The Other Half of Edda's Order",
   "turnin": "r20_anchor_014_host",
   "xp": 135
  },
  {
   "copper": 13,
   "description": "Highcourt has plenty of fine words; Mariel Waybook could use another pair of working hands. Go speak with her there if you fancy helping our human allies. Tell her I trust you with a job, which is only one step below trusting you with my oven.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_dispatch_highcourt",
