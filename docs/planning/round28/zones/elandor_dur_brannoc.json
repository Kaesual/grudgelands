  {
   "copper": 13,
   "description": "I can stamp a pledge of support all day, but Faeris Rootbinder needs someone to walk through the gate. Report to Faeris at Glassroot Gate in the contested Glassroot Wilds and let our elven allies see what a promise from Dur Brannoc weighs.",
   "giver": "r20_dwarf_capital_envoy",
   "giver_name": "Dorrin Gateledger",
