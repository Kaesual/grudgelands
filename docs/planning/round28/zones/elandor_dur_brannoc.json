 "quests": [
  {
   "copper": 51,
   "description": "Our ancestors deserve respect, but a settled account deserves to stay settled. Put eight Debtbound Zombies to rest at night in the Dur Brannoc Pastures, which lie in the south of Dur Brannoc. They keep knocking to collect debts we wrote off generations ago, and I refuse to wake the entire records hall to prove it.",
   "giver": "r20_dwarf_capital_envoy",
   "giver_name": "Dorrin Gateledger",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_gate_01",
   "min_level": 20,
   "objectives": [
    "kill 8 debtbound_zombie [in elandor_dur_brannoc/pastures]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_dur_brannoc/pastures",
     "count": 8,
     "mobs": [
      "grug_mobs:debtbound_zombie"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Payment Was Final",
   "turnin": "r20_dwarf_capital_envoy",
   "xp": 520
  },
  {
   "copper": 26,
   "description": "The crusts are ready, but a pie full of air won't see a smith through a shift. Bring me four Mire Carp from the rivers or tarns outside Dur Brannoc's gates; take your time with the rod while I take mine with the pastry.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_provisions_01",
   "min_level": 20,
   "objectives": [
    "bring 4 grug_fishing:mire_carp"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "grug_fishing:mire_carp",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Pie Needs a Middle",
   "turnin": "r20_dwarf_capital_cook",
   "xp": 260
  },
  {
   "copper": 13,
   "description": "Edda Tarnmantle asked me for bread and someone who can swing more than a butter knife. The loaves are already on the cart. Go speak to her at Tarnwatch Fold on the Frostbarrow Shelf about the other half of her order. Button your coat before you leave, or I'll hear about it from Edda.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_dispatch_01",
   "min_level": 21,
   "objectives": [
