   "reward_items": [],
   "title": "Room at Another Hearth",
   "turnin": "r20_anchor_018_host",
   "xp": 140
  },
  {
   "copper": 13,
   "description": "An Accord worth its salt ought to mean more than sharing a colour on a banner. If you'd like work among our human neighbours, speak with Merren Oakstamp at Whitebridge Market Close. Tell Merren that Varda sent someone dependable, and try to make me look a sound judge of character.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_dispatch_whitebridge",
