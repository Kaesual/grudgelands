   "reward_items": [],
   "title": "A Neighbour's Table",
   "turnin": "r20_anchor_016_host",
   "xp": 140
  },
  {
   "copper": 58,
   "description": "I checked the toll register twice; the king has granted these thieves precisely nothing. Defeat eight outlaws in all, counting Toll Bandit Archers and Toll Bandits, at night in the Dur Brannoc Tollwood, which lies in the east of Dur Brannoc. Deal with the archers before they put their objections in writing on your coat.",
   "giver": "r20_dwarf_capital_envoy",
   "giver_name": "Dorrin Gateledger",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_gate_02",
