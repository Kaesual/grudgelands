   ],
   "reward_items": [],
   "title": "Varda's Recommendation",
   "turnin": "r20_human_capital_envoy",
   "xp": 140
  },
  {
   "copper": 13,
   "description": "A dwarf can lend a hand beneath branches as well as beams. If you'd like to help our elven neighbours, find Ilwen Petalmeasure at Lorindor Berrycourt and ask what needs doing; good neighbours make room at the hearth before the weather turns.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_dispatch_lorindor",
   "min_level": 22,
