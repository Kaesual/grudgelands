   "xp": 543
  },
  {
   "copper": 77,
   "description": "Every crooked entry leads to the Dur Brannoc Goblin Camp north from here, where Goblin Ore-Factor Brakk buys the stolen ore. Recover two Clasped Purses from his Ore-Thieving Goblins or Rubble Goblin Slingers, and kill Brakk himself. Draw him out alone if you can; we've lost enough honest folk balancing his books.",
   "giver": "r20_dwarf_capital_envoy",
   "giver_name": "Dorrin Gateledger",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_gate_03",
   "min_level": 27,
   "objectives": [
