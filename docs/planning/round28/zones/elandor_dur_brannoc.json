   "title": "His Majesty Signed Nothing",
   "turnin": "r20_dwarf_capital_envoy",
   "xp": 675
  },
  {
   "copper": 45,
   "description": "Fish fills a pie, but a feast-day roast wants ram. If you have a spare afternoon, hunt six Hill Rams by day in the Dur Brannoc Uplands, which lie in the heart of Dur Brannoc. They stay quiet until someone starts the argument, so pick your ram and pick your moment.",
   "giver": "r20_dwarf_capital_cook",
   "giver_name": "Varda Copperpan",
   "giver_settlement": "Dur Brannoc",
   "id": "durbrannoc_provisions_optional",
