   ],
   "reward_items": [],
   "title": "The Rain Owes You Nothing",
   "turnin": "r14_troll_steward",
   "xp": 360
  },
  {
   "copper": 5,
   "description": "Those collectors have to carry our coin somewhere, and I cannot follow them while keeping this village above water. Go to Raincall Outpost and tell Neshi Reedstep what you found on the paths. She can follow a trail through rain that would wash the spots off a cat.",
   "giver": "r14_troll_steward",
   "giver_name": "Daro Kapok",
   "giver_settlement": "Raincall Village",
   "id": "raincall_rains_04",
   "min_level": 13,
   "objectives": [
