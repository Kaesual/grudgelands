 "quests": [
  {
   "copper": 21,
   "description": "Welcome to Raincall, where we catch the rain and the Reed Tapirs sit on what it grows. Kill eight tapirs by day in the Raincall Rainwood, which grows in the north of Raincall Basin, so our gardens can stand up again. Strangers have started demanding a rain tithe from the farms, too. I have tended this basin for years, and the clouds have never once sent a collector.",
   "giver": "r14_troll_steward",
   "giver_name": "Daro Kapok",
   "giver_settlement": "Raincall Village",
   "id": "raincall_rains_01",
   "min_level": 10,
   "objectives": [
    "kill 8 reed_tapir [in kragmar_raincall_basin/rainwood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_raincall_basin/rainwood",
     "count": 8,
     "mobs": [
      "grug_mobs:reed_tapir"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "kapok_departure"
   ],
   "reward_items": [],
   "title": "A Garden Is No Wallow",
   "turnin": "r14_troll_steward",
   "xp": 320
  },
  {
   "copper": 21,
   "description": "A wet root trips you; a Reed-Fang Viper takes offence at your whole foot. Kill eight vipers after dark on the paths through the Raincall Rainwood. Their venom is quick, so mind where you step and keep something to drink close at hand.",
   "giver": "r14_troll_steward",
   "giver_name": "Daro Kapok",
   "giver_settlement": "Raincall Village",
   "id": "raincall_rains_02",
   "min_level": 11,
   "objectives": [
    "kill 8 reed_fang_viper [in kragmar_raincall_basin/rainwood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_raincall_basin/rainwood",
     "count": 8,
     "mobs": [
      "grug_mobs:reed_fang_viper"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "raincall_rains_01"
   ],
   "reward_items": [],
   "title": "Mind Where the Path Hisses",
   "turnin": "r14_troll_steward",
   "xp": 340
  },
  {
   "copper": 13,
   "description": "A rain cape with a hole is just a very personal waterfall. Bring me three Leather from the Reed Tapirs that roam the Raincall Rainwood by day, in the north of Raincall Basin. If Daro already has you clearing the gardens, let one muddy walk earn its keep twice.",
   "giver": "r15_troll_local",
   "giver_name": "Amari Palmweave",
   "giver_settlement": "Raincall Village",
   "id": "raincall_weave_01",
   "min_level": 11,
   "objectives": [
    "bring 3 mobs:leather"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "mobs:leather",
     "type": "item"
    }
   ],
   "prerequisites": [
    "kapok_departure"
   ],
   "reward_items": [],
   "title": "Capes Before the Downpour",
   "turnin": "r15_troll_local",
   "xp": 213
  },
  {
   "copper": 21,
   "description": "Those rain-tithe men are Roadside Bandits, prowling the Raincall Rainwood after dark among the vipers. Kill six of them. They claim to collect for Vek, but Vek has yet to send us so much as a drizzle.",
   "giver": "r14_troll_steward",
   "giver_name": "Daro Kapok",
   "giver_settlement": "Raincall Village",
   "id": "raincall_rains_03",
   "min_level": 12,
   "objectives": [
