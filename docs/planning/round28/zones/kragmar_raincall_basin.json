   "xp": 450
  },
  {
   "copper": 23,
   "description": "We marked the trail with rope, and the Kapok Gnawers took that as an invitation to supper. Kill eight after dark in the Raincall Cloudwood. I can teach a scout to find a trail in the rain; I cannot teach one to find it inside a rat.",
   "giver": "r14_troll_scout",
   "giver_name": "Neshi Reedstep",
   "giver_settlement": "Raincall Outpost",
