   "xp": 473
  },
  {
   "copper": 16,
   "description": "Palm fibre knots itself tighter than gossip in a rainbound house. Bring me two Hooked Cat Claws from the Reed Jungle Lynxes hunting by day in the Raincall Cloudwood; my weavers need them to comb it out. The claws may come inside, but the rest of the cat stays where you found it.",
   "giver": "r15_troll_local",
   "giver_name": "Amari Palmweave",
   "giver_settlement": "Raincall Village",
   "id": "raincall_weave_03",
