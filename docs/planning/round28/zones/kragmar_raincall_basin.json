   "reward_items": [],
   "title": "Houses Should Not Bow",
   "turnin": "r15_troll_local",
   "xp": 285
  },
  {
   "copper": 23,
   "description": "I can follow a tithe collector through the Raincall Cloudwood, in the southeast of Raincall Basin; doing it with Reed Jungle Lynxes following me is another matter. Kill eight lynxes there by day and give my scouts room to work. The collectors leave clumsy tracks, but I would prefer to read them without teeth in my shoulder.",
   "giver": "r14_troll_scout",
   "giver_name": "Neshi Reedstep",
   "giver_settlement": "Raincall Outpost",
   "id": "raincall_watch_01",
