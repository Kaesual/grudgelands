   "reward_items": [],
   "title": "Let the Scouts Hear It",
   "turnin": "r14_troll_scout",
   "xp": 95
  },
  {
   "copper": 16,
   "description": "Our stilt houses nod when the water rises, and I do not care for that sort of greeting. Bring me four Iron Bars and four Coal Lumps for the smith to make new brackets. I can mend the curtains, but someone else must persuade the walls to stay under them.",
   "giver": "r15_troll_local",
   "giver_name": "Amari Palmweave",
   "giver_settlement": "Raincall Village",
   "id": "raincall_weave_02",
   "min_level": 13,
   "objectives": [
