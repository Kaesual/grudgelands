   "title": "Optional: Eyes in the Rimewood",
   "turnin": "r20_anchor_026_host",
   "xp": 595
  },
  {
   "copper": 32,
   "description": "The tide has brought us another welcome committee with claws. Kill six Barnacle Pinchers on the Frostbarrow Rime Shore southwest from here by day and return for your bounty. This job is repeatable thirty minutes after you hand it in; the sea has never respected a finished shift.",
   "giver": "r20_anchor_026_host",
   "giver_name": "Hedra Rimebell",
   "giver_settlement": "Rimebell Watch",
   "id": "frostbarrow_bounty_pinchers",
