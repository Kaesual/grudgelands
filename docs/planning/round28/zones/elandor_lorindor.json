   ],
   "prerequisites": [
    "lorindor_berries_02"
   ],
   "reward_items": [],
   "title": "Berries Do Not Walk Away",
   "turnin": "r20_anchor_016_host",
   "xp": 150
  },
  {
   "copper": 32,
   "description": "A traveller sees a light between the trunks and thinks someone has left a lantern for them. Extinguish five Wandering Wisps after dark in the Lorindor Elderwood, which lies in the west of Lorindor, before that kindness turns into another lost traveller. They appear only at night; keep the path in sight while you work.",
   "giver": "r20_anchor_034_host",
   "giver_name": "Orya Petalward",
   "giver_settlement": "Petalbank Wardenry",
   "id": "lorindor_wardenry_01",
