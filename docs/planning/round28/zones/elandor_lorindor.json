   "xp": 375
  },
  {
   "copper": 19,
   "description": "Even roots that have held for centuries appreciate a brace before they need it. Bring me four Steel Bars here at the cutting for payment; this is a standing order you may fill again. I would rather replace a prop than write a song about the tunnel it failed to hold.",
   "giver": "r20_anchor_063_host",
   "giver_name": "Saevin Rootscribe",
   "giver_settlement": "Paleroot Cutting",
