   ],
   "reward_items": [],
   "title": "Shells by the Bedrolls",
   "turnin": "r14_orc_elder",
   "xp": 180
  },
  {
   "copper": 40,
   "description": "At level 10, follow Redtusk Road to Redtusk Village and speak with Borak Redgrass. Redtusk Savanna is level 11\u201320 country, not a beginner hunting ground. Complete the conversation with Borak; this handoff requires neither a kill nor a return trip.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
