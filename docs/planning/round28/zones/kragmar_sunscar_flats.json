   "reward_items": [],
   "title": "The Thirsting Dead",
   "turnin": "r14_orc_elder",
   "xp": 180
  },
  {
   "copper": 30,
   "description": "Scorpions have crawled under the bedrolls. Clear the camp edge before nightfall. Near the start they hunt by day and by night on level-4-and-up ground.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_05_shells_by_the_bedrolls",
   "min_level": 5,
