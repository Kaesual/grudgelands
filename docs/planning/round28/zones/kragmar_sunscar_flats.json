 "quests": [
  {
   "copper": 10,
   "description": "Boars tear the water skins outside Sunscar by day. Drive off three and carry spare raw meat to Ugra Brothstone at the separate oven.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_01_tusks_at_the_water_skins",
   "min_level": 1,
   "objectives": [
    "kill 3 boar or small_boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:boar",
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Tusks at the Water Skins",
   "turnin": "r14_orc_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from sunscar's outer paths. Bring four raw meat portions to Ugra Brothstone beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_orc_start_cook",
   "giver_name": "Ugra Brothstone",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_02_meat_for_the_long_fire",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Meat for the Long Fire",
   "turnin": "r20_orc_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe. Gara will show the safe cut before strength becomes waste.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_10_edge_of_the_first_camp",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Edge of the First Camp",
   "turnin": "r14_orc_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Ugra Brothstone keeps Sunscar's long fire supplied beside the oven. Bring three coal lumps for the covered fuel box. Existing or traded coal is welcome; You can mine natural coal with any pickaxe, including wood or stone.",
   "giver": "r20_orc_start_cook",
   "giver_name": "Ugra Brothstone",
   "giver_settlement": "Sunscar",
   "id": "r20_orc_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Keep the Long Fire Fed",
   "turnin": "r20_orc_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick. Stone has no pride, but it punishes a careless swing.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_11_stone_has_no_pride",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_orc_10_edge_of_the_first_camp"
   ],
   "reward_items": [],
   "title": "Stone Has No Pride",
   "turnin": "r14_orc_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "The hide racks need new feet before another load pulls them into the dust. Bring six acacia planks from the ordinary local timber, or use boards already carried or traded.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_03_rats_under_the_hide_racks",
   "min_level": 3,
   "objectives": [
    "bring 6 default:acacia_wood"
   ],
   "objectives_raw": [
    {
     "count": 6,
     "item": "default:acacia_wood",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_orc_01_tusks_at_the_water_skins"
   ],
   "reward_items": [],
   "title": "Posts Beneath the Hide Racks",
   "turnin": "r14_orc_elder",
   "xp": 100
  },
  {
   "copper": 25,
   "description": "Sun-dried husks walk the outer flats toward Redtusk after nightfall. Defeat three on the level-4-and-up ground between the camp and the Redtusk border before they reach the water skins. The rack repairs and optional tool lessons remain daytime work.",
   "giver": "r14_orc_elder",
   "giver_name": "Gara Stonevoice",
   "giver_settlement": "Sunscar",
   "id": "r14_orc_04_the_thirsting_dead",
   "min_level": 5,
   "objectives": [
    "kill 3 sun_dried_husk or befuddled_husk or sluggish_husk"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:sun_dried_husk",
      "grug_mobs:befuddled_husk",
