   "turnin": "r20_troll_capital_cook",
   "xp": 260
  },
  {
   "copper": 6,
   "description": "Tokai Knotreader can read trouble in the river knots, yet never seems to foresee the last fish leaving the plate. Go to Totemwater Post in Totemwater Reach and speak with Tokai. Say the smokehouse remembers, and ask what the river has been saying lately.",
   "giver": "r20_troll_capital_cook",
   "giver_name": "Teshani Smokereed",
