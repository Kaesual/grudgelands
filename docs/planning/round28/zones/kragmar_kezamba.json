   "turnin": "r20_troll_capital_envoy",
   "xp": 390
  },
  {
   "copper": 26,
   "description": "Half of Kezamba follows its nose to my door, and I cannot feed it the smell. Bring me eight Raw Meat from the Reed Tapirs grazing by day in the Kezamba Canopy. The smokehouse needs something to smoke before those noses turn into complaints.",
   "giver": "r20_troll_capital_cook",
   "giver_name": "Teshani Smokereed",
