     "type": "talk"
    }
   ],
   "prerequisites": [
    "goldmead_watch_02"
   ],
   "reward_items": [],
   "title": "A Witness, Not Cargo",
   "turnin": "r14_human_captive",
   "xp": 110
  },
  {
   "copper": 10,
   "description": "I mend the sacks; the Burrow Gnawers put in fresh ventilation. Kill eight after dark in the Goldmead Hedgerows, which run in the northeast of Goldmead Vale, and come back for your bounty. This is repeatable work: I can offer it again twenty minutes after you turn it in.",
   "giver": "r15_human_local",
   "giver_name": "Alda Sheaf",
