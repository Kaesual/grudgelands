   "reward_items": [],
   "title": "Bounty: Roadside Bandits (repeatable)",
   "turnin": "r14_human_scout",
   "xp": 220
  },
  {
   "copper": 21,
   "description": "Hobb listed me between grain and packing cloth, then had the nerve to ask whether I could write. His Bandit Lookouts guard the Goldmead Requisition Camp west from here day and night; defeat eight of them. Approach from the edge and break their line of fire when you need to. I would lend a hand, but they requisitioned my good boots too.",
   "giver": "r14_human_captive",
   "giver_name": "Pella Thatch",
   "giver_settlement": "Goldmead Bandit Camp",
