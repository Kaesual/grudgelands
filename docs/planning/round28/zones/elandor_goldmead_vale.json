     "type": "item"
    }
   ],
   "prerequisites": [
    "goldmead_stores_01",
    "goldmead_watch_01"
   ],
   "reward_items": [],
   "title": "Cloth Around the Truth",
   "turnin": "r15_human_local",
   "xp": 275
  },
  {
   "copper": 10,
   "description": "Another batch of Roadside Bandits is collecting at the Goldmead Bandit Camp east from here; apparently robbery offers steady employment. Defeat eight and report back for payment, by day or night. You can take this bounty again twenty minutes after turning it in.",
   "giver": "r14_human_scout",
   "giver_name": "Jon Vale",
   "giver_settlement": "Goldmead Outpost",
