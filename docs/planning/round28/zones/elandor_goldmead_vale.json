     "mobs": [
      "grug_mobs:rabid_fox"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "goldmead_watch_01"
   ],
   "reward_items": [],
   "title": "Teeth Along the Cart Track",
   "turnin": "r14_human_scout",
   "xp": 368
  },
  {
   "copper": 13,
   "description": "The Roadside Bandits at the Goldmead Bandit Camp east from here are carrying our packing cloth as though they bought it. Bring me two lengths of Linen Cloth from them; cloth you saved from an earlier fight will do. Their camp is occupied day and night, so fit the errand around your other work. I would like one shipment to reach its buyer with both its wrapping and its contents intact.",
   "giver": "r15_human_local",
   "giver_name": "Alda Sheaf",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_stores_02",
   "min_level": 16,
   "objectives": [
    "bring 2 grug_mobs:linen_cloth"
   ],
   "objectives_raw": [
