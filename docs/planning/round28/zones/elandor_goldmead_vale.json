 "pvp_rule": "peaceful",
 "quests": [
  {
   "copper": 18,
   "description": "Crumb's accounts name Requisitioner Hobb as the man he answered to. Hobb's collectors will find precious little to steal if we cannot bring the harvest in. Hunt eight Bracken Foxes by day in the Goldmead Orchards, which lie in the south of Goldmead Vale; the pickers need room to work. We will untangle Hobb's business once ours is back on its feet.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_harvest_01",
   "min_level": 9,
   "objectives": [
    "kill 8 young_fox [in elandor_goldmead_vale/orchards]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_goldmead_vale/orchards",
     "count": 8,
     "mobs": [
      "grug_mobs:young_fox"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "dawnmere_departure"
   ],
   "reward_items": [],
   "title": "A Harvest Worth Stealing",
   "turnin": "r14_human_steward",
   "xp": 280
  },
  {
   "copper": 10,
   "description": "Our grain counters have worked through dinner again, which improves neither their sums nor their company. Bring me eight cuts of Raw Meat here in Goldmead Village; whatever you saved from the road will do. They deserve a meal they cannot accidentally enter as grain.",
   "giver": "r15_human_local",
   "giver_name": "Alda Sheaf",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_stores_01",
   "min_level": 10,
   "objectives": [
    "bring 8 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 8,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [
    "dawnmere_departure"
   ],
   "reward_items": [],
   "title": "Feed the Counters",
   "turnin": "r15_human_local",
   "xp": 160
  },
  {
   "copper": 18,
   "description": "I can account for every sack that leaves Goldmead, except the ones leaving a mouthful at a time. Kill eight Granary Rats after dark in the same Goldmead Orchards. Work the edges and keep your distance between fights; a squealing rat is an invitation to all its neighbours.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_harvest_02",
   "min_level": 11,
   "objectives": [
    "kill 8 granary_rat [in elandor_goldmead_vale/orchards]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_goldmead_vale/orchards",
     "count": 8,
     "mobs": [
      "grug_mobs:granary_rat"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "goldmead_harvest_01"
   ],
   "reward_items": [],
   "title": "The Granary Has Teeth",
   "turnin": "r14_human_steward",
   "xp": 298
  },
  {
   "copper": 16,
   "description": "Hobb has sent enough paper promises to patch every roof in Goldmead; our granary doors need something sturdier. Bring me six Iron Bars and four Coal Lumps from the valley's ore. Check what pick the rock needs before digging, then smelt the iron in a furnace. The grain we still have deserves a sound door.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_supplies_01",
   "min_level": 12,
   "objectives": [
    "bring 6 grug_materials:iron_bar",
    "bring 4 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 6,
     "item": "grug_materials:iron_bar",
     "type": "item"
    },
    {
     "count": 4,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [
    "goldmead_harvest_01"
   ],
   "reward_items": [],
   "title": "Iron Before Promises",
   "turnin": "r14_human_steward",
   "xp": 285
  },
  {
   "copper": 21,
   "description": "Ridgeback Tuskers are flattening the Goldmead Wheatfields, in the west of Goldmead Vale, and the farmers have already lost enough this season. Bring down eight by day. Their red names mean they will charge without provocation, so give yourself room and face them one at a time.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_harvest_03",
   "min_level": 13,
   "objectives": [
    "kill 8 bristling_boar [in elandor_goldmead_vale/wheatfields]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_goldmead_vale/wheatfields",
     "count": 8,
     "mobs": [
      "grug_mobs:bristling_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "goldmead_harvest_02"
   ],
   "reward_items": [],
   "title": "Tusks in the Wheat",
   "turnin": "r14_human_steward",
   "xp": 400
  },
  {
   "copper": 5,
   "description": "You have seen what threatens our harvest; Jon Vale has been watching the people who take it. Follow the road to Goldmead Outpost and speak with him about Hobb's collectors. He counts wagons more patiently than anyone I know, though I doubt he would welcome that on his gravestone.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_harvest_04",
   "min_level": 13,
   "objectives": [
    "talk to Jon Vale (goldmead_outpost)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r14_human_scout",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "goldmead_harvest_02"
   ],
   "reward_items": [],
   "title": "Jon Has the Other Half",
   "turnin": "r14_human_scout",
   "xp": 95
  },
  {
   "copper": 21,
   "description": "Hobb's Roadside Bandits hold the Goldmead Bandit Camp east from here day and night, demanding payment from people who have already paid. Defeat eight of them. Watch for their Bandit Lookouts and approach from the edge; a collector with a bow is much less persuasive once you are beside him.",
   "giver": "r14_human_scout",
   "giver_name": "Jon Vale",
   "giver_settlement": "Goldmead Outpost",
   "id": "goldmead_watch_01",
   "min_level": 14,
   "objectives": [
    "kill 8 quarrelsome_bandit [in elandor_goldmead_vale/bandit_camp]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_goldmead_vale/bandit_camp",
     "count": 8,
     "mobs": [
      "grug_mobs:quarrelsome_bandit"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "goldmead_harvest_04"
   ],
   "reward_items": [],
   "title": "Collectors Without a Collection",
   "turnin": "r14_human_scout",
   "xp": 420
  },
  {
   "copper": 16,
   "description": "The granary has its iron; now we must see the shipment safely packed. Bring me four more Iron Bars and six planks of any wood here in Goldmead Village. I will count and seal the load myself, and the next collector who calls it his wages can explain that to my face.",
   "giver": "r14_human_steward",
   "giver_name": "Marta Millward",
   "giver_settlement": "Goldmead Village",
   "id": "goldmead_supplies_02",
   "min_level": 15,
   "objectives": [
    "bring 4 grug_materials:iron_bar",
    "bring 6 group:wood"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "grug_materials:iron_bar",
