   "title": "Nobody Requisitions Pella",
   "turnin": "r14_human_captive",
   "xp": 460
  },
  {
   "copper": 5,
   "description": "Pella Thatch is being held in the Goldmead Bandit Camp east from here, where Hobb's men have entered her in their accounts as cargo. Clear your approach and speak with her about what she has seen. She knows Hobb's ledgers and remembers every stolen sack. Best not to mention the cargo entry unless you have time to hear her opinion of it.",
   "giver": "r14_human_scout",
   "giver_name": "Jon Vale",
   "giver_settlement": "Goldmead Outpost",
   "id": "goldmead_watch_03",
   "min_level": 17,
