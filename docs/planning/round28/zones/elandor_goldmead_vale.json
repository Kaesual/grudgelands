   ],
   "reward_items": [],
   "title": "Counted and Sealed",
   "turnin": "r14_human_steward",
   "xp": 330
  },
  {
   "copper": 18,
   "description": "A cart that gets past Hobb's men still has to pass the Thicket Vixens in the Goldmead Thickets west of Goldmead Outpost. Hunt six by day. Their red names mean they attack on sight, so keep a clear way out of the brush. I want the drivers home with their boots still occupied.",
   "giver": "r14_human_scout",
   "giver_name": "Jon Vale",
   "giver_settlement": "Goldmead Outpost",
   "id": "goldmead_watch_02",
   "min_level": 15,
