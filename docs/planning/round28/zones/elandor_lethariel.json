   "title": "A Debt Beyond the Grave",
   "turnin": "r20_elf_capital_envoy",
   "xp": 325
  },
  {
   "copper": 13,
   "description": "Ilwen Petalmeasure's berry deliveries keep shrinking, though her crate lists remain beautifully written. Visit her at Lorindor Berrycourt, following the road out into Lorindor, and ask what these tolls are costing us. One cannot bake the missing half of a pie from elegant handwriting.",
   "giver": "r20_elf_capital_cook",
   "giver_name": "Mirael Petalpot",
   "giver_settlement": "Lethariel",
   "id": "lethariel_dispatch_01",
