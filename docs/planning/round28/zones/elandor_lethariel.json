 "quests": [
  {
   "copper": 19,
   "description": "The Star Hall has requested a meal worthy of its deliberations; I should prefer one ready before they end. Bring me five pieces of Raw Meat and one Braided Sinew, hunting Moss-Antler Stags by day in the Lethariel Glades south of Lethariel for the sinew. Their yellow names mean they will not attack first, so choose your quarry with care.",
   "giver": "r20_elf_capital_cook",
   "giver_name": "Mirael Petalpot",
   "giver_settlement": "Lethariel",
   "id": "lethariel_provisions_01",
