   "xp": 270
  },
  {
   "copper": 19,
   "description": "We have recipes older than the Accord and a larder that never survives the week. Bring me eight pieces of Raw Meat here in Lethariel for payment. This supply order is repeatable; long life has done nothing to diminish anyone's appetite.",
   "giver": "r20_elf_capital_cook",
   "giver_name": "Mirael Petalpot",
