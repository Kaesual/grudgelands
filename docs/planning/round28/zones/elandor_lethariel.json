   "reward_items": [],
   "title": "The Missing Half of the Pie",
   "turnin": "r20_anchor_018_host",
   "xp": 135
  },
  {
   "copper": 13,
   "description": "Lethen Moonledger can predict a star's return but has missed a month's worth of bread collections. Speak with him at the Moonfall Observatory in Moonfall Wood and find out what keeps him from us. If he says he has been busy, remind him that dough rises without an appointment.",
   "giver": "r20_elf_capital_cook",
   "giver_name": "Mirael Petalpot",
   "giver_settlement": "Lethariel",
   "id": "lethariel_dispatch_02",
