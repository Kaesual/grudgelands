    },
    {
     "count": 1,
     "mobs": [
      "grug_mobs:marrow_archivist"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Filed Under Theft",
   "turnin": "r20_anchor_064_host",
   "xp": 1073
  },
  {
   "copper": 13,
   "description": "The Reach can file its own dead again; the living are needed elsewhere. Go to Ashveil Watch in Blackwind Rise and report to Vaska Ashlistener, who holds that ground for the Throng against the Accord. Tell Vaska the Archivist is closed, and that I would like the stones there left as they were carved.",
   "giver": "r20_anchor_064_host",
   "giver_name": "Neris Fossilhand",
   "giver_settlement": "Memoryvein Dig",
   "id": "ossuary_dig_04",
