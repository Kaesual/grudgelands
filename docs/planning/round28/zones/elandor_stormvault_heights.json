   "reward_items": [],
   "title": "A Toll Paid in Arrows",
   "turnin": "r20_anchor_028_host",
   "xp": 770
  },
  {
   "copper": 64,
   "description": "The Trench Shamblers in the Stormvault Frostfields, which lie in the northeast of Stormvault Heights, still march after dark, long past any reasonable end to their service. Put down eight of them so the living watch can hold its ground. You may take this bounty again twenty-five minutes after turning it in; I'll keep the pay ready.",
   "giver": "r20_anchor_028_host",
   "giver_name": "Alna Archsight",
   "giver_settlement": "Archshadow Post",
