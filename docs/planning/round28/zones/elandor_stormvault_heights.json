   "objectives": [
    "bring 8 default:pine_wood"
   ],
   "objectives_raw": [
    {
     "count": 8,
     "item": "default:pine_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Shutters Against the Storm",
   "turnin": "r20_anchor_027_host",
   "xp": 1220
  },
  {
   "copper": 85,
   "description": "Frost strays stand on Stormvault Heights' gravel and snow after dark, loosing arrows across the ascent. Defeat four so the watch can reach its storm markers.",
   "giver": "r20_anchor_027_host",
   "giver_name": "Borin Splitbolt",
   "giver_settlement": "Splitbolt Station",
   "id": "r20_anchor_027_02",
   "min_level": 31,
   "objectives": [
