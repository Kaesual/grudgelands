 "quests": [
  {
   "copper": 58,
   "description": "Kill eight Dust-Stinger Scorpions after dark on the Speargrass Plains, in the northeast of Speargrass Reach; they burrow into the cut grass and our cutters come home limping and swearing at every shadow. Tell those scorpions my cutters are still using their ankles, if you think they will listen.",
   "giver": "r20_anchor_022_host",
   "giver_name": "Brakka Jarward",
   "giver_settlement": "Speargrass Wellhold",
   "id": "speargrass_grass_01",
   "min_level": 21,
   "objectives": [
    "kill 8 dust_stinger [in kragmar_speargrass_reach/plains]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_speargrass_reach/plains",
     "count": 8,
     "mobs": [
      "grug_mobs:dust_stinger"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Still Using Those Ankles",
   "turnin": "r20_anchor_022_host",
   "xp": 608
  },
  {
   "copper": 19,
   "description": "The undead of Nhal Veyr buy our spears, and I have never had to ask twice for a favour they owed. Travel to their city and speak to Ossa Quietregister on our behalf. Mind your manners; a bare jaw can still take offence.",
   "giver": "r20_anchor_022_host",
   "giver_name": "Brakka Jarward",
   "giver_settlement": "Speargrass Wellhold",
   "id": "speargrass_journeys_01",
   "min_level": 22,
   "objectives": [
    "talk to Ossa Quietregister (nhal_veyr)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_undead_capital_envoy",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "speargrass_grass_01"
   ],
   "reward_items": [],
   "title": "Promises Outlast Breath",
   "turnin": "r20_undead_capital_envoy",
   "xp": 210
  },
  {
   "copper": 58,
   "description": "Redpick Yard has worn out another pick, and the sorting trays are trying to follow it into the scrap heap. Bring me four Steel Bars so we can keep working. The rock will still be here tomorrow, but I would prefer less of it.",
   "giver": "r20_anchor_065_host",
   "giver_name": "Gorren Redpick",
   "giver_settlement": "Redpick Yard",
   "id": "speargrass_yard_01",
   "min_level": 23,
   "objectives": [
    "bring 4 grug_materials:steel_bar"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "grug_materials:steel_bar",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Yard Eats Steel",
   "turnin": "r20_anchor_065_host",
   "xp": 653
  },
  {
   "copper": 58,
   "description": "I count every cutter who leaves the Wellhold, and lately the returning count has been short. Kill eight Tallgrass Tigers by day in the Speargrass Tallgrass, in the east of Speargrass Reach. Let our people keep their eyes on their work for once.",
   "giver": "r20_anchor_022_host",
   "giver_name": "Brakka Jarward",
   "giver_settlement": "Speargrass Wellhold",
   "id": "speargrass_grass_02",
   "min_level": 24,
   "objectives": [
    "kill 8 reed_stalking_tiger [in kragmar_speargrass_reach/tallgrass]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_speargrass_reach/tallgrass",
     "count": 8,
     "mobs": [
      "grug_mobs:reed_stalking_tiger"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "speargrass_grass_01"
   ],
   "reward_items": [],
   "title": "Optional: Count the Cutters Home",
   "turnin": "r20_anchor_022_host",
   "xp": 675
  },
  {
   "copper": 45,
   "description": "The smith has an idea for our pick tips, and for once I like the sound of it. Bring me three Shearing Cat Claws from Tallgrass Tigers in the Speargrass Tallgrass; hunt them by day. Getting the claws is your part, and convincing the smith to stop talking and start fitting them is mine.",
   "giver": "r20_anchor_065_host",
   "giver_name": "Gorren Redpick",
   "giver_settlement": "Redpick Yard",
   "id": "speargrass_yard_02",
   "min_level": 25,
   "objectives": [
    "bring 3 grug_mobs:shearing_cat_claw"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "grug_mobs:shearing_cat_claw",
     "type": "item"
    }
   ],
   "prerequisites": [
    "speargrass_yard_01"
   ],
   "reward_items": [],
   "title": "Optional: Put the Claws to Work",
   "turnin": "r20_anchor_065_host",
   "xp": 543
  },
  {
   "copper": 58,
   "description": "When dark falls, Dustpack Hyenas gather in the Speargrass Hunting Grounds, in the heart of Speargrass Reach, and our patrols hear every hungry mouth. Kill eight at night for Cutgrass Watch. I would sleep better knowing fewer teeth were waiting for the next patrol.",
   "giver": "r20_anchor_042_host",
   "giver_name": "Morga Cutgrass",
   "giver_settlement": "Cutgrass Watch",
   "id": "speargrass_watch_01",
   "min_level": 26,
   "objectives": [
    "kill 8 dustpack_hyena [in kragmar_speargrass_reach/hunting_grounds]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_speargrass_reach/hunting_grounds",
     "count": 8,
     "mobs": [
      "grug_mobs:dustpack_hyena"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Optional: Teeth Beyond the Watch",
   "turnin": "r20_anchor_042_host",
   "xp": 743
  },
  {
   "copper": 32,
   "description": "Tallgrass Tigers keep prowling the Speargrass Hunting Grounds by day, and chasing them off is eating into our work. Kill six and return for the yard's bounty. The job opens again twenty minutes after you collect; I can pay for dead tigers or lost shifts, and I prefer the tigers.",
   "giver": "r20_anchor_065_host",
   "giver_name": "Gorren Redpick",
   "giver_settlement": "Redpick Yard",
   "id": "speargrass_bounty",
   "min_level": 28,
   "objectives": [
    "kill 6 reed_stalking_tiger [in kragmar_speargrass_reach/hunting_grounds]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_speargrass_reach/hunting_grounds",
     "count": 6,
     "mobs": [
      "grug_mobs:reed_stalking_tiger"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "speargrass_yard_02"
   ],
   "reward_items": [],
   "title": "Bounty: Stripes on the Payroll (repeatable)",
   "turnin": "r20_anchor_065_host",
   "xp": 425
  },
  {
   "copper": 83,
   "description": "Goblin Banner-Broker Rakk is selling our stolen war banners back to us from the Speargrass Goblin Camp, south from here. Kill eight of his Ore-Thieving Goblins or Rubble Goblin Slingers in any mix, and kill Rakk himself. Orcs bled beneath those colours; he will not haggle over them.",
   "giver": "r20_anchor_042_host",
   "giver_name": "Morga Cutgrass",
   "giver_settlement": "Cutgrass Watch",
   "id": "speargrass_watch_02",
   "min_level": 28,
   "objectives": [
