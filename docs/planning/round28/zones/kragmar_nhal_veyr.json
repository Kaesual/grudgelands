   "reward_items": [],
   "title": "A Debt Freely Owed",
   "turnin": "r20_anchor_039_host",
   "xp": 263
  },
  {
   "copper": 700,
   "description": "Our shroud cupboard is nearly bare, and I refuse to enter 'wrapped in a sack' beside another name. Bring me two Glass Spider Silk from the Glass-Web Jungle Spiders at night in the Skyglass Rootways, which lie in the north of The Skyglass Canopy. We may keep our dead for centuries; we can at least dress them properly.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
   "giver_settlement": "Nhal Veyr",
   "id": "nv_front_01",
