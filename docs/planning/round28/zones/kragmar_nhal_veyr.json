   "reward_items": [],
   "title": "Dressed for the Long Rest",
   "turnin": "r20_undead_capital_envoy",
   "xp": 1050
  },
  {
   "copper": 800,
   "description": "The register has a space for the end of every watch; I have left these entries open for far too long. Lay five Last Watchmen to rest after dark on the Gravesalt Whitewall, which lies in the northeast of Gravesalt Escarpment, and I can finally record their release.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
