   "title": "The Account Is Closed",
   "turnin": "r20_undead_capital_envoy",
   "xp": 990
  },
  {
   "copper": 19,
   "description": "I have entered your service in the register, with thanks rather than a sum beside it. Go to Ashveil Watch in Blackwind Rise and report to Vaska Ashlistener; the Throng holds that ground against the Accord. I would prefer to hear of your next deeds from you, rather than from someone bringing me a name to enter.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_vigil_04",
