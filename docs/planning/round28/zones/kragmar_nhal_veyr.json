   ],
   "reward_items": [],
   "title": "Repeatable: The Kitchen Keeps Going (repeatable)",
   "turnin": "r20_undead_capital_cook",
   "xp": 388
  },
  {
   "copper": 77,
   "description": "Zombie Mortuary-Clerk Hush holds court over a ledger in the Nhal Veyr Tombfields, southwest from here, entering our dead as debtors. Kill Hush, and destroy four Tithe Revenants among those tombs at night. A name is all some of these people have left, and I will not let a clerk seize it for arrears.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_vigil_03",
