 "quests": [
  {
   "copper": 58,
   "description": "Debtbound Zombies walk the Nhal Veyr Blightfields, which lies in the heart of Nhal Veyr, at night, knocking to collect debts that appear nowhere in my register. Lay eight to rest before they wear their knuckles down to the last joint. Each carries a clerk's stamp, so this is an unauthorised collection conducted with an infuriating air of legitimacy.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_vigil_01",
   "min_level": 19,
   "objectives": [
    "kill 8 debtbound_zombie [in kragmar_nhal_veyr/blightfields]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_nhal_veyr/blightfields",
     "count": 8,
     "mobs": [
      "grug_mobs:debtbound_zombie"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Payment Due After Death",
   "turnin": "r20_undead_capital_envoy",
   "xp": 585
  },
  {
   "copper": 19,
   "description": "Sovel Namekeeper at Ossuary Ledgerstead needs help: the Gravewood around the archive has begun waking, which cannot be good for quiet study. Go and speak with Sovel, and pass along my regards. I would send a meal, but Sovel never eats, and I refuse to have my cooking filed for posterity.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_dispatch_01",
   "min_level": 20,
   "objectives": [
    "talk to Sovel Namekeeper (r20_anchor_020)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_020_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "nhal_veyr_vigil_01"
   ],
   "reward_items": [],
   "title": "Send My Regards, They Keep Better",
   "turnin": "r20_anchor_020_host",
   "xp": 195
  },
  {
   "copper": 32,
   "description": "Bring me eight Raw Meat from the Moss-Antler Gaunt Stags grazing the Nhal Veyr Blightfields by day. Some mourners have kept vigil so long they have forgotten there is a kitchen. I set places for them anyway; a warm bowl gives the hands something to do when they have run out of things to hold.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_provisions_01",
   "min_level": 20,
   "objectives": [
    "bring 8 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 8,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Optional: A Seat at the Table",
   "turnin": "r20_undead_capital_cook",
   "xp": 338
  },
  {
   "copper": 64,
   "description": "Tithe Revenants stalk the Nhal Veyr Gravefields, which lies in the east of Nhal Veyr, after dark, charging the dead for being dead and the living for taking their time. Destroy eight. Their stamps bear the same clerk's mark: Hush. I have spent centuries keeping these names, and I will not have them turned into a list of debtors.",
   "giver": "r20_undead_capital_envoy",
   "giver_name": "Ossa Quietregister",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_vigil_02",
   "min_level": 23,
   "objectives": [
    "kill 8 stubborn_zombie [in kragmar_nhal_veyr/gravefields]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_nhal_veyr/gravefields",
     "count": 8,
     "mobs": [
      "grug_mobs:stubborn_zombie"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "nhal_veyr_vigil_01"
   ],
   "reward_items": [],
   "title": "The Cost of Staying Dead",
   "turnin": "r20_undead_capital_envoy",
   "xp": 750
  },
  {
   "copper": 13,
   "description": "Thorga Roadspeaker in Gor Drazhak complains that everyone wants good roads and nobody turns up to help keep them. Go and speak with Thorga; you have made a fine habit of turning up where you are needed. One of my three sister errands is enough, even if you do have an eternity to fill.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_dispatch_orc_capital",
   "min_level": 24,
   "objectives": [
    "talk to Thorga Roadspeaker (gor_drazhak)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_orc_capital_envoy",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "nhal_veyr_vigil_02"
   ],
   "reward_items": [],
   "title": "Sister Errand: Someone to Walk the Roads",
   "turnin": "r20_orc_capital_envoy",
   "xp": 150
  },
  {
   "copper": 13,
   "description": "Brakka Jarward at Speargrass Wellhold in Speargrass Reach could use another pair of hands. Go and speak with Brakka; do keep the hands attached, since our allies tend to find the alternative unsettling. Choose one of my three sister errands to follow; I am sending you for work, not trying to misplace you.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_dispatch_orc_wellhold",
   "min_level": 24,
   "objectives": [
    "talk to Brakka Jarward (r20_anchor_022)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_022_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "nhal_veyr_vigil_02"
   ],
   "reward_items": [],
   "title": "Sister Errand: Hands for the Wellhold",
   "turnin": "r20_anchor_022_host",
   "xp": 150
  },
  {
   "copper": 13,
   "description": "If you choose the Whispering Reedlands, speak with Taleko Drycord at Whisperreed Landing about the work there. Take care of your boots; damp gets into joints you had forgotten you owned. You need only follow one of my three sister errands, so there is no obligation to fall apart in every climate.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_dispatch_troll",
   "min_level": 24,
   "objectives": [
    "talk to Taleko Drycord (r20_anchor_024)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_024_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "nhal_veyr_vigil_02"
   ],
   "reward_items": [],
   "title": "Sister Errand: Try to Stay Dry",
   "turnin": "r20_anchor_024_host",
   "xp": 150
  },
  {
   "copper": 32,
   "description": "Bring me four Pickled Flesh from the Tithe Revenants in the Nhal Veyr Gravefields after dark. I mean to compare the samples with my brine; someone is pickling the dead without a licence, and it is giving preservation a bad name. Hand them to me directly, please, well away from the serving bowls.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_provisions_02",
   "min_level": 24,
   "objectives": [
    "bring 4 grug_mobs:pickled_flesh"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "grug_mobs:pickled_flesh",
     "type": "item"
    }
   ],
   "prerequisites": [
    "nhal_veyr_provisions_01"
   ],
   "reward_items": [],
   "title": "Optional: Keep It Off the Menu",
   "turnin": "r20_undead_capital_cook",
   "xp": 375
  },
  {
   "copper": 32,
   "description": "Plague Razorbacks root through the Nhal Veyr Gravefields, which lies in the east of Nhal Veyr, by day, and the kitchen has another hunt to pay for. Kill six and report back; this order calls for news of the hunt, so keep whatever meat you gather. I can offer it again thirty minutes after you hand it in, by which time someone will certainly be asking about supper.",
   "giver": "r20_undead_capital_cook",
   "giver_name": "Velis Mourningbowl",
   "giver_settlement": "Nhal Veyr",
   "id": "nhal_veyr_provisions_bounty",
