   "title": "Unhelpful Allies",
   "turnin": "r14_elf_scout",
   "xp": 400
  },
  {
   "copper": 13,
   "description": "A ribbon round a trunk tells our wardens which trees need watching. Bring me three pieces of Linen Cloth from the Roadside Bandits at the Starbough Bandit Camp west from here, where you can find them day or night. Their stolen cloth can serve the wood for once.",
   "giver": "r15_elf_local",
   "giver_name": "Lethri Reedshade",
   "giver_settlement": "Starbough Village",
   "id": "starbough_stores_03",
