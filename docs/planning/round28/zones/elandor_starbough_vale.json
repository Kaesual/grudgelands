   "reward_items": [],
   "title": "A Ribbon Means We Remember",
   "turnin": "r15_elf_local",
   "xp": 263
  },
  {
   "copper": 21,
   "description": "The trail ends at the Starbough Bandit Camp west from here, where Roadside Bandits buy the poachers' catch. Defeat eight of them; they conduct their trade by day and night alike. Nima Fern is held there, so keep your head: we need her alive to tell us what she has seen.",
   "giver": "r14_elf_scout",
   "giver_name": "Theren Farstep",
