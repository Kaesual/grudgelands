   ],
   "reward_items": [],
   "title": "A Scout's Eye for Knots",
   "turnin": "r14_elf_scout",
   "xp": 95
  },
  {
   "copper": 21,
   "description": "My scouts can pass without stirring a leaf; that helps little when the underbrush bites back. Kill seven Thicket Vixens by day in the Starbough Greenwood, which lies in the heart of Starbough Vale. They attack on sight, so choose your ground before they choose you.",
   "giver": "r14_elf_scout",
   "giver_name": "Theren Farstep",
   "giver_settlement": "Starbough Outpost",
   "id": "starbough_watch_01",
   "min_level": 14,
