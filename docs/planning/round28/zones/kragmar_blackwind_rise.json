   "turnin": "r20_anchor_040_host",
   "xp": 1025
  },
  {
   "copper": 112,
   "description": "The Entrenched Bandit Archers at the Pallcloth Den west from here take every Throng banner as an invitation to shoot. Kill four before another carrier has to crawl home beneath one; my people have enough trouble keeping their limbs attached.",
   "giver": "r20_anchor_040_host",
