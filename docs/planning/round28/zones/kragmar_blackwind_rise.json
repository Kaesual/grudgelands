   ],
   "reward_items": [],
   "title": "Orrel Is Still Waiting",
   "turnin": "r20_anchor_040_host",
   "xp": 293
  },
  {
   "copper": 160,
   "description": "Grave-Broker Mute sells linen stolen from our dead at the Blackwind Bandit Hideout east from here. Kill four of his Entrenched Bandits or Entrenched Bandit Archers in any combination, and kill Mute as well. Some of us are still wearing what he considers stock.",
   "giver": "r20_anchor_040_host",
   "giver_name": "Orrel Hollowstep",
   "giver_settlement": "Hollowarch Station",
   "id": "blackwind_arch_02",
   "min_level": 35,
   "objectives": [
