    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Crates Before Glory",
   "turnin": "r20_anchor_040_host",
   "xp": 700
  },
  {
   "copper": 48,
   "description": "Orrel Hollowstep keeps Hollowarch Station supplied while the Accord tests how much pressure its defenders can bear. Go to him; he needs someone who can finish a job before the next crisis arrives. Eternity has done nothing for his patience.",
   "giver": "r20_anchor_039_host",
   "giver_name": "Vaska Ashlistener",
   "giver_settlement": "Ashveil Watch",
   "id": "blackwind_ashes_04",
   "min_level": 33,
   "objectives": [
    "talk to Orrel Hollowstep (r20_anchor_040)"
   ],
   "objectives_raw": [
