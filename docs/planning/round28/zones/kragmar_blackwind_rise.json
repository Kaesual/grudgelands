 "quests": [
  {
   "copper": 112,
   "description": "Bonewood Plaguehide Bears have taken to opening our dispatches, usually with the runner still attached. Hunt them by day in the Blackwind Bonewood, which lies in the northeast of Blackwind Rise, and kill four. I prefer bad news delivered with all its limbs.",
   "giver": "r20_anchor_039_host",
   "giver_name": "Vaska Ashlistener",
   "giver_settlement": "Ashveil Watch",
   "id": "blackwind_ashes_01",
   "min_level": 29,
   "objectives": [
    "kill 4 territorial_bear [in kragmar_blackwind_rise/bonewood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_blackwind_rise/bonewood",
     "count": 4,
     "mobs": [
      "grug_mobs:territorial_bear"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Bad News Travels on Legs",
   "turnin": "r20_anchor_039_host",
   "xp": 630
  },
  {
   "copper": 128,
   "description": "Roots ought to stay buried, a rule the Lichen Gravewood Treants ignore after dark in the Blackwind Bonewood. Fell four and bring me two portions of Bitter Resin for Ashveil's lamps. Yes, I hear the irony; I am choosing to ignore it.",
   "giver": "r20_anchor_039_host",
   "giver_name": "Vaska Ashlistener",
   "giver_settlement": "Ashveil Watch",
   "id": "blackwind_ashes_02",
   "min_level": 31,
   "objectives": [
    "kill 4 mourning_treant [in kragmar_blackwind_rise/bonewood]",
    "bring 2 grug_mobs:bitter_resin"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_blackwind_rise/bonewood",
     "count": 4,
     "mobs": [
      "grug_mobs:mourning_treant"
     ],
     "type": "kill"
    },
    {
     "count": 2,
     "item": "grug_mobs:bitter_resin",
     "type": "item"
    }
   ],
   "prerequisites": [
    "blackwind_ashes_01"
   ],
   "reward_items": [],
   "title": "Trees Without Leave",
   "turnin": "r20_anchor_039_host",
   "xp": 740
  },
  {
   "copper": 48,
   "description": "Drek Rampbinder grows anxious when Ashveil falls silent, though he calls it concern for the supply lines. Report to him at Red Ramp Post on Bannerbreak Mesa and tell him our watch still holds. He may thump you on the shoulder; brace yourself, that is orcish relief.",
   "giver": "r20_anchor_039_host",
   "giver_name": "Vaska Ashlistener",
   "giver_settlement": "Ashveil Watch",
   "id": "blackwind_ashes_03",
   "min_level": 32,
   "objectives": [
    "talk to Drek Rampbinder (r20_anchor_043)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_043_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "blackwind_ashes_02"
   ],
   "reward_items": [],
   "title": "Still Standing, Still Dead",
   "turnin": "r20_anchor_043_host",
   "xp": 285
  },
  {
   "copper": 64,
   "description": "The Bonewood Plaguehide Bears in the Blackwind Bonewood remain unmoved by our casualty reports. Kill six during daylight and collect your pay. Twenty minutes after payment, I can offer the bounty again; apparently we are budgeting for an endless appetite.",
   "giver": "r20_anchor_039_host",
   "giver_name": "Vaska Ashlistener",
   "giver_settlement": "Ashveil Watch",
   "id": "blackwind_ashes_bounty",
   "min_level": 32,
   "objectives": [
    "kill 6 territorial_bear [in kragmar_blackwind_rise/bonewood]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_blackwind_rise/bonewood",
     "count": 6,
     "mobs": [
      "grug_mobs:territorial_bear"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "blackwind_ashes_02"
   ],
   "reward_items": [],
   "title": "Bounty: A Recurring Appetite (repeatable)",
   "turnin": "r20_anchor_039_host",
   "xp": 380
  },
  {
   "copper": 112,
   "description": "Everyone wants a glorious last stand until they discover the supply crates have been eaten. Kill four Marrow Weevils by day in the Blackwind Webwood, which lies in the east of Blackwind Rise, before they chew through another shipment. I have already had one last stand, and I intend to provision this one properly.",
   "giver": "r20_anchor_040_host",
   "giver_name": "Orrel Hollowstep",
   "giver_settlement": "Hollowarch Station",
   "id": "blackwind_arch_01",
   "min_level": 33,
   "objectives": [
    "kill 4 marrow_weevil [in kragmar_blackwind_rise/webwood]"
   ],
   "objectives_raw": [
