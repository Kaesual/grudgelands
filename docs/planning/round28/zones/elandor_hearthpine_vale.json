   "xp": 105
  },
  {
   "copper": 3,
   "description": "A cold oven is just a cupboard with ambitions. Mine five Coal Lumps from the rock outside town and bring them to me when you have a break from hunting. Try the public oven while you're here: coal in the fuel slot, raw food in the cooking slot, and patience until supper.",
   "giver": "r20_dwarf_start_cook",
   "giver_name": "Hilda Hearthspoon",
   "giver_settlement": "Hearthpine",
   "id": "hearthpine_kitchen_02",
