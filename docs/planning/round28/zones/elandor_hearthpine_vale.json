   "turnin": "r14_dwarf_elder",
   "xp": 140
  },
  {
   "copper": 30,
   "description": "Ibex knock loose slate above Hearthpine's high path by day. Clear the animals on level-4-and-up ground along the ledges.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_05_the_high_path",
