 "quests": [
  {
   "copper": 10,
   "description": "Boars are tearing through the timberline stores outside Hearthpine. Drive off three by day, and bring any ordinary meat you keep to Hilda Hearthspoon at the separate oven.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_01_tusks_at_the_timberline",
   "min_level": 1,
   "objectives": [
    "kill 3 boar or small_boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:boar",
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Tusks at the Timberline",
   "turnin": "r14_dwarf_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from hearthpine's outer paths. Bring four raw meat portions to Hilda Hearthspoon beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_dwarf_start_cook",
   "giver_name": "Hilda Hearthspoon",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_02_meat_for_the_smokehouse",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Meat for the Smokehouse",
   "turnin": "r20_dwarf_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe so Brunna can show where its edge belongs and where it does not.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_10_an_axe_worth_carrying",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "An Axe Worth Carrying",
   "turnin": "r14_dwarf_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Hilda keeps the timber shift fed beside Hearthpine's oven. Bring three coal lumps for its fuel box; existing or traded coal is welcome. If you mine it yourself, use a pickaxe, even wood or stone, on a natural coal source rather than dismantling protected village scenery.",
   "giver": "r20_dwarf_start_cook",
   "giver_name": "Hilda Hearthspoon",
   "giver_settlement": "Hearthpine",
   "id": "r20_dwarf_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Warmth for the Timber Shift",
   "turnin": "r20_dwarf_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick. The lesson is optional, but the mountain is less forgiving than wood.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_11_stone_before_steel",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_dwarf_10_an_axe_worth_carrying"
   ],
   "reward_items": [],
   "title": "Stone Before Steel",
   "turnin": "r14_dwarf_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "The woodpile pests exposed rotten braces beneath the winter stacks. Bring six pine planks for the store frames; ordinary boards from local pine trunks, carried or traded, are equally useful.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_03_rats_in_the_woodpiles",
   "min_level": 3,
   "objectives": [
    "bring 6 default:pine_wood"
   ],
   "objectives_raw": [
    {
     "count": 6,
     "item": "default:pine_wood",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_dwarf_01_tusks_at_the_timberline"
   ],
   "reward_items": [],
   "title": "Boards for the Winter Stacks",
   "turnin": "r14_dwarf_elder",
   "xp": 100
  },
  {
   "copper": 25,
   "description": "After nightfall, zombies approach the lantern line outside Hearthpine. Defeat three on that night patrol. They begin in the level-3 country; do the daytime store work or optional tool lessons if the sun is still up.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "r14_dwarf_04_lanterns_after_sundown",
   "min_level": 4,
   "objectives": [
    "kill 3 zombie or braindead_zombie or sluggish_zombie"
   ],
   "objectives_raw": [
    {
     "count": 3,
