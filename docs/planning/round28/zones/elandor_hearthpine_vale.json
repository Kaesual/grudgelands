     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Pig's Breakfast",
   "turnin": "r14_dwarf_elder",
   "xp": 105
  },
  {
   "copper": 2,
   "description": "Every mouth in Hearthpine wants supper, including the smokehouse. Bring me five logs from trees outside town, at any hour; logs, mind, not planks. Leave the town trees standing, or you'll answer to Brunna before you answer to me.",
   "giver": "r20_dwarf_start_cook",
   "giver_name": "Hilda Hearthspoon",
   "giver_settlement": "Hearthpine",
   "id": "hearthpine_kitchen_01",
   "min_level": 1,
   "objectives": [
    "bring 5 group:tree"
   ],
   "objectives_raw": [
    {
     "count": 5,
     "group": "tree",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Feed the Fire First",
   "turnin": "r20_dwarf_start_cook",
   "xp": 30
  },
  {
   "copper": 2,
   "description": "Before you go making a name for yourself, make something with a handle. Craft a Wooden Axe and a Wooden Pickaxe and bring both to me here in Hearthpine. A miner's first tools hang on the hall wall for luck, so yours go up beside your grandmother's, and you take a seasoned pair from the rack in their place.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "hearthpine_tools_01",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood",
    "bring 1 grug_materials:pick_wood"
   ],
   "objectives_raw": [
