 "quests": [
  {
   "copper": 6,
   "description": "Small Boars are rooting through our pit props in the heart of Hearthpine Vale, and I refuse to lose a miner to a pig's breakfast. Kill eight by day; a yellow name means they leave you be until you strike. Save any meat for Hilda, then we'll see about the ore thieves.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "hearthpine_hunt_01",
   "min_level": 1,
   "objectives": [
    "kill 8 small_boar [in elandor_hearthpine_vale/timberline]"
   ],
   "objectives_raw": [
