    "grug_materials:pick_wood 1"
   ],
   "title": "Hands Before Heroics",
   "turnin": "r14_dwarf_elder",
   "xp": 30
  },
  {
   "copper": 6,
   "description": "Our timber has acquired a night crew with teeth and no respect for joinery. Kill eight Large Rats in the heart of Hearthpine Vale after dark. A red name means they'll attack on sight, and a rat's squeal brings nearby rats running; pick your fights before they pick you.",
   "giver": "r14_dwarf_elder",
   "giver_name": "Brunna Flintbraid",
   "giver_settlement": "Hearthpine",
   "id": "hearthpine_hunt_02",
   "min_level": 2,
