 "quests": [
  {
   "copper": 10,
   "description": "Jungle boars turn up the yam beds outside Kapok by day. Drive off three, and bring spare raw meat to Zemi Sweetroot at the separate oven shelter.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
   "id": "r14_troll_01_boars_in_the_yam_beds",
   "min_level": 1,
   "objectives": [
    "kill 3 jungle_boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:jungle_boar"
     ],
     "type": "kill",
     "zone": false
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Boars in the Yam Beds",
   "turnin": "r14_troll_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from kapok's outer paths. Bring four raw meat portions to Zemi Sweetroot beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_troll_start_cook",
   "giver_name": "Zemi Sweetroot",
   "giver_settlement": "Kapok",
   "id": "r14_troll_02_fill_the_evening_pot",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Fill the Evening Pot",
   "turnin": "r20_troll_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe and Zalima will show how to keep the handle dry and the cut clean.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
   "id": "r14_troll_10_a_dry_handled_axe",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "description": "Bring a wood axe",
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Dry-Handled Axe",
   "turnin": "r14_troll_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Zemi Sweetroot has moved the common pot under Kapok's oven shelter before the rain arrives. Bring three coal lumps for the dry fuel basket. Traded supplies count; mining coal yourself only requires a pickaxe; wood and stone picks work too.",
   "giver": "r20_troll_start_cook",
   "giver_name": "Zemi Sweetroot",
   "giver_settlement": "Kapok",
   "id": "r20_troll_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Pot Before the Rain",
   "turnin": "r20_troll_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick for a lesson in reading rock beneath moss and root.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
   "id": "r14_troll_11_stone_beneath_the_moss",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "description": "Bring a stone pick",
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_troll_10_a_dry_handled_axe"
   ],
   "reward_items": [],
   "title": "Stone Beneath the Moss",
   "turnin": "r14_troll_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "Kapok's dry baskets need a new frame above the wet ground. Bring six junglewood planks for the supports. Ordinary planks from local jungle trunks, existing supplies and traded boards all count.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
   "id": "r14_troll_03_teeth_in_the_basket_weave",
   "min_level": 3,
   "objectives": [
    "bring 6 default:junglewood"
   ],
   "objectives_raw": [
    {
     "count": 6,
     "item": "default:junglewood",
