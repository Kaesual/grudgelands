   "reward_items": [],
   "title": "Supper Above the Mud",
   "turnin": "r20_troll_start_cook",
   "xp": 110
  },
  {
   "copper": 3,
   "description": "You have learned to read roots; now read the rock beneath them. Mine copper and tin outside town, smelt the lumps in a furnace, and bring me three Copper Bars and three Tin Bars. One lump makes one bar, which is the sort of honest accounting I wish we had at feasts.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
   "id": "kapok_tools_03",
