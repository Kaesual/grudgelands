    }
   ],
   "prerequisites": [
    "r14_troll_01_boars_in_the_yam_beds"
   ],
   "reward_items": [],
   "title": "A Dry Frame for the Baskets",
   "turnin": "r14_troll_elder",
   "xp": 100
  },
  {
   "copper": 25,
   "description": "Zombies wander the rootways beyond Kapok after nightfall. Defeat three on level-3-and-up ground. The basket repair and optional tool lessons are available without waiting for the night patrol.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
