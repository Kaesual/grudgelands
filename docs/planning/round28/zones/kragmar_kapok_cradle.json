   "reward_items": [],
   "title": "Guests with Pincers",
   "turnin": "r20_troll_start_cook",
   "xp": 90
  },
  {
   "copper": 4,
   "description": "One loose knot and my drying racks will serve supper to the mud. Bring me two Fine Sinews from the Young Tapirs grazing by day in the west of Kapok Cradle, in the Kapok Broadleaf Wood. The tapirs wait for you to start trouble; the Aggressive Jungle Lynxes sharing their ground do not.",
   "giver": "r20_troll_start_cook",
   "giver_name": "Zemi Sweetroot",
   "giver_settlement": "Kapok",
   "id": "kapok_pantry_03",
   "min_level": 5,
