   "xp": 140
  },
  {
   "copper": 30,
   "description": "Vipers shelter beneath the broad leaves beside the homes. Clear the nearest nests. Near the start they hunt by day and by night on level-4-and-up ground.",
   "giver": "r14_troll_elder",
   "giver_name": "Zalima Rainhum",
   "giver_settlement": "Kapok",
