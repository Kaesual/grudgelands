    "kapok_hunt_01"
   ],
   "reward_items": [],
   "title": "A Hunter Worth Inviting",
   "turnin": "r20_troll_start_cook",
   "xp": 75
  },
  {
   "copper": 4,
   "description": "A feast needs Crab Legs, and I refuse to count the guests' legs as a substitute. Bring me two from the Small Crabs in the Kapok Shallows north from here. They leave you be until you strike, so choose your crab before you start waving your hands.",
   "giver": "r20_troll_start_cook",
   "giver_name": "Zemi Sweetroot",
   "giver_settlement": "Kapok",
   "id": "kapok_pantry_02",
