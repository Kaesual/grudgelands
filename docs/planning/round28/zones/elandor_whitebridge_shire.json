   "title": "Bounty: Briar-Web Spiders (repeatable)",
   "turnin": "r20_anchor_030_host",
   "xp": 340
  },
  {
   "copper": 51,
   "description": "Mirefolk Ferryman Murk runs the Whitebridge Ferry Camp west from here, charging whatever he thinks a frightened carter will pay. Defeat him; he is there by day and night. There will always be thieves along the river, but this one ought to learn that honest trade has defenders too.",
   "giver": "r20_anchor_030_host",
   "giver_name": "Jessa Axlewright",
   "giver_settlement": "Oakspan Tollhouse",
   "id": "whitebridge_river_02",
