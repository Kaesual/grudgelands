   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Basket Toll",
   "turnin": "r20_anchor_030_host",
   "xp": 495
  },
  {
   "copper": 26,
   "description": "The Briar-Web Spiders have strung the Whitebridge Thornwood, which lies in the northeast of Whitebridge Shire, with enough web to wrap a wagon. Kill six there after dark and report back for your bounty. I can offer the job again twenty-five minutes after you turn it in; bring yourself back, and leave the spiders where they fall.",
   "giver": "r20_anchor_030_host",
   "giver_name": "Jessa Axlewright",
   "giver_settlement": "Oakspan Tollhouse",
   "id": "whitebridge_bounty_spiders",
