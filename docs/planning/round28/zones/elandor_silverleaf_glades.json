   "xp": 165
  },
  {
   "copper": 4,
   "description": "The planting crews eat last and pretend they are not hungry. Bring me ten pieces of Raw Meat from your hunts; boars or rats will do, and anything already in your pack counts. I mean to have supper waiting before anyone has to pretend.",
   "giver": "r20_elf_start_cook",
