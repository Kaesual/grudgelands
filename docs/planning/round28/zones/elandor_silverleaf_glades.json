   "reward_items": [],
   "title": "A Shore Supper",
   "turnin": "r20_elf_start_cook",
   "xp": 100
  },
  {
   "copper": 4,
   "description": "A little age improves a recipe, but it does nothing for the dust above my flour. Bring me two Fox Tails from Young Foxes in the Silverleaf Foxglades by day. One brush for the shelf, one held in reserve: that is how a kitchen survives an elf's idea of a short visit.",
   "giver": "r20_elf_start_cook",
   "giver_name": "Liora Dewpot",
