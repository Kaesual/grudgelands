   "title": "The Ferns Have Teeth",
   "turnin": "r14_elf_elder",
   "xp": 105
  },
  {
   "copper": 3,
   "description": "The elder can warm a gathering with a speech; I have tried it on the oven without success. Mine five Coal Lumps from the rock outside Silverleaf and bring them to me. When you cook for yourself, put fuel in the fuel slot and raw food in the cooking slot; neither benefits from a speech.",
   "giver": "r20_elf_start_cook",
   "giver_name": "Liora Dewpot",
   "giver_settlement": "Silverleaf",
   "id": "silverleaf_kitchen_02",
