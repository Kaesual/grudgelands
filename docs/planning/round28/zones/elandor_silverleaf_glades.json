   ],
   "title": "A Lesson That Holds Its Edge",
   "turnin": "r14_elf_elder",
   "xp": 60
  },
  {
   "copper": 6,
   "description": "Dune grass bends beneath a living foot and rises after it; the dead give it no such respite. Lay six Braindead Zombies to rest at night on the Silverleaf Strand, which lies in the south of Silverleaf Glades. Go before sunrise, when the light takes them, and leave the shore its quiet.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
