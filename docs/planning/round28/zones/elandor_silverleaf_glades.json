   ],
   "reward_items": [],
   "title": "Embers Before Eloquence",
   "turnin": "r20_elf_start_cook",
   "xp": 60
  },
  {
   "copper": 3,
   "description": "You have learned the grain; now learn the weight. Mine plain stone outside Silverleaf with your wooden pick, then make one Stone Axe and one Stone Pickaxe. Bring both here for a tested pair in exchange, and let patience guide your hands before strength does.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
