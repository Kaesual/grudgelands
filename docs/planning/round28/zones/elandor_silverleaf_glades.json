    "grug_materials:pick_wood 1"
   ],
   "title": "Begin with the Grain",
   "turnin": "r14_elf_elder",
   "xp": 30
  },
  {
   "copper": 6,
   "description": "Listen beneath the ferns after dark: that scratching is no woodland lullaby. Kill eight Large Rats in the glades near Silverleaf, before they gnaw through another season's planting. Draw them out carefully; one frightened squeal brings the neighbours.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "silverleaf_hunt_02",
