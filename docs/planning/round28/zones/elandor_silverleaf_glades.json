 "quests": [
  {
   "copper": 6,
   "description": "We planted those saplings for children yet unborn; the Small Boars consider them breakfast. Cull eight by day near Silverleaf; their yellow names mean they will leave you alone until you strike. The boars are not our only trouble, though: some stems out there were cut clean, and no snout cuts clean.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "silverleaf_hunt_01",
   "min_level": 1,
   "objectives": [
    "kill 8 small_boar [in elandor_silverleaf_glades/home_glades]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_silverleaf_glades/home_glades",
     "count": 8,
     "mobs": [
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Century Down the Snout",
   "turnin": "r14_elf_elder",
   "xp": 105
  },
  {
   "copper": 2,
   "description": "An elf may spend a century choosing a tree; supper allows me rather less. Bring me five logs of any tree, cut outside Silverleaf's protected ground. Whole logs, please, not planks: I have an oven to feed, not a floor to mend.",
   "giver": "r20_elf_start_cook",
   "giver_name": "Liora Dewpot",
   "giver_settlement": "Silverleaf",
   "id": "silverleaf_kitchen_01",
   "min_level": 1,
   "objectives": [
    "bring 5 group:tree"
   ],
   "objectives_raw": [
    {
     "count": 5,
     "group": "tree",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Oven Keeps No Seasons",
   "turnin": "r20_elf_start_cook",
   "xp": 30
  },
  {
   "copper": 2,
   "description": "Before you tend a forest, learn what a piece of wood will bear. Make one Wooden Axe and one Wooden Pickaxe and bring them to me here in Silverleaf. Your work will serve the seed store; in exchange, you shall have a tested pair from mine.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "silverleaf_tools_01",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood",
    "bring 1 grug_materials:pick_wood"
   ],
   "objectives_raw": [
