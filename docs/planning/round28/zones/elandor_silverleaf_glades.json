   ],
   "title": "A Hall Should Not Creak",
   "turnin": "r14_elf_elder",
   "xp": 110
  },
  {
   "copper": 4,
   "description": "Copper and tin each have their virtues; put them together and you gain another. Use your Dual Furnace to alloy three Bronze Bars and bring them here, gathering fresh materials because the earlier bars went into our hinges. A Bronze Pickaxe awaits you in exchange, for the rock beyond these glades has lessons of its own.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
