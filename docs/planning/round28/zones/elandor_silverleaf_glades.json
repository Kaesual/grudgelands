 "quests": [
  {
   "copper": 10,
   "description": "Boars expose young roots outside Silverleaf by day. Drive off three, then consider taking spare raw meat to Liora Dewpot at the grove's separate oven.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "r14_elf_01_roots_laid_bare",
   "min_level": 1,
   "objectives": [
    "kill 3 boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:boar"
     ],
     "type": "kill",
     "zone": false
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Roots Laid Bare",
   "turnin": "r14_elf_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from silverleaf's outer paths. Bring four raw meat portions to Liora Dewpot beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_elf_start_cook",
   "giver_name": "Liora Dewpot",
   "giver_settlement": "Silverleaf",
   "id": "r14_elf_02_the_grove_s_portion",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Grove's Portion",
   "turnin": "r20_elf_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe. Saelin's lesson is about choosing a tree before raising the tool.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "r14_elf_10_the_careful_axe",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "description": "Bring a wood axe",
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Careful Axe",
   "turnin": "r14_elf_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Liora Dewpot wants the grove's evening meal ready before the gatherers return. Bring three coal lumps to the oven in Silverleaf. Existing or traded fuel is welcome; a pickaxe is needed (wood and stone work too) if you choose to mine natural coal yourself.",
   "giver": "r20_elf_start_cook",
   "giver_name": "Liora Dewpot",
   "giver_settlement": "Silverleaf",
   "id": "r20_elf_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Shared Grove Supper",
   "turnin": "r20_elf_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick and learn why stone rewards patience rather than force.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "r14_elf_11_stone_s_patient_lesson",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "description": "Bring a stone pick",
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_elf_10_the_careful_axe"
   ],
   "reward_items": [],
   "title": "Stone's Patient Lesson",
   "turnin": "r14_elf_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "The seed baskets need a sound frame before the youngest roots can be covered again. Bring six ordinary oak planks; nearby oak trunks provide them, and traded boards are welcome. Silverwood is not required.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
   "id": "r14_elf_03_beneath_the_seed_baskets",
