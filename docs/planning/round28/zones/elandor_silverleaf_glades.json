   "title": "Dust Is Not a Seasoning",
   "turnin": "r20_elf_start_cook",
   "xp": 110
  },
  {
   "copper": 4,
   "description": "Our hall has heard a great deal of wisdom; lately its hinges insist on answering. Smelt three Copper Bars and three Tin Bars from ore around Silverleaf and bring them here for the repairs. I will give you my old Dual Furnace for your next lesson; set it up outside protected ground.",
   "giver": "r14_elf_elder",
   "giver_name": "Saelin Dewbough",
   "giver_settlement": "Silverleaf",
