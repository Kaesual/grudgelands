   "reward_items": [],
   "title": "Let the Grass Remember Footsteps",
   "turnin": "r14_elf_elder",
   "xp": 135
  },
  {
   "copper": 3,
   "description": "Three generations of careful weaving, and a rat decides my seed baskets need doors. Hunt Large Rats after dark in the glades near Silverleaf and bring me two Rat Fur Patches. I shall mend the baskets; you may keep any extra patches for your own work.",
   "giver": "r20_elf_start_cook",
