 "quests": [
  {
   "copper": 6,
   "description": "Small Boars are eating next winter's bread in the Dawnmere Home Fields near Dawnmere. Hunt eight by day; their yellow names mean they fight back only when struck. A fellow called Crumb has been helping himself to our grain too, but let us begin with the thieves who cannot read.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "dawnmere_hunt_01",
   "min_level": 1,
   "objectives": [
    "kill 8 small_boar [in elandor_dawnmere_fields/home_fields]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_dawnmere_fields/home_fields",
     "count": 8,
     "mobs": [
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Crop Thieves",
   "turnin": "r14_human_elder",
   "xp": 105
  },
  {
   "copper": 2,
   "description": "Bring me five logs from any tree outside Dawnmere, whenever your hands are free. The oven needs fuelwood, not a debate about which tree is fashionable. Leave the trees inside town alone; I will not have my supper blamed for a missing village green.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
   "giver_settlement": "Dawnmere",
   "id": "dawnmere_kitchen_01",
   "min_level": 1,
   "objectives": [
    "bring 5 group:tree"
   ],
   "objectives_raw": [
    {
     "count": 5,
     "group": "tree",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Five Logs, Any Tree",
   "turnin": "r20_human_start_cook",
   "xp": 30
  },
  {
   "copper": 2,
   "description": "Make a Wooden Axe and a Wooden Pickaxe from wood, then bring both to me here in Dawnmere. I will check your work and give you a working pair in return. A sword looks splendid over a hearth, but somebody still has to chop the firewood.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "dawnmere_tools_01",
   "min_level": 1,
   "objectives": [
