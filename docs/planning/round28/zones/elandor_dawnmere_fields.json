   "title": "The Night Shift",
   "turnin": "r14_human_elder",
   "xp": 120
  },
  {
   "copper": 3,
   "description": "An oven full of good intentions still serves a cold dinner. Bring me five Coal Lumps from the rock outside Dawnmere when your hunts leave you time. At the public oven, coal goes in the fuel slot and raw food in the cooking slot; get those right and we can call you useful in two trades.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
   "giver_settlement": "Dawnmere",
