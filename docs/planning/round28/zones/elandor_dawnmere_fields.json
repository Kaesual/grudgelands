   "reward_items": [],
   "title": "A Proper Fire",
   "turnin": "r20_human_start_cook",
   "xp": 60
  },
  {
   "copper": 3,
   "description": "Those wooden tools have earned their keep; let us put a better edge on your next day's work. Use your wooden pick on suitable rock outside Dawnmere, then make a Stone Axe and a Stone Pickaxe and bring both to me. I will check them and give you a working pair for the ore work ahead.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
