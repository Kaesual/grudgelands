   "reward_items": [],
   "title": "The Rats Can Mend It",
   "turnin": "r20_human_start_cook",
   "xp": 60
  },
  {
   "copper": 6,
   "description": "Our hens have taken to sleeping with one eye open, thanks to the Young Foxes in the Dawnmere Pastures, in the northeast of Dawnmere Fields. Hunt eight by day. Watch for Aggressive Boars among them: a red name means the creature will start the fight without waiting for you.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
