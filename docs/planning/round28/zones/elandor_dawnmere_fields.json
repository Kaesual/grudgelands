 "quests": [
  {
   "copper": 10,
   "description": "Boars root through the outer seed rows by day. Drive off three beyond Dawnmere's fence, and take spare raw meat to Bess Honeycrust beside the village oven.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "r14_human_01_boars_beyond_the_fence",
   "min_level": 1,
   "objectives": [
    "kill 3 boar or small_boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:boar",
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Boars Beyond the Fence",
   "turnin": "r14_human_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from dawnmere's outer paths. Bring four raw meat portions to Bess Honeycrust beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
   "giver_settlement": "Dawnmere",
   "id": "r14_human_02_the_smokehouse_share",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Smokehouse Share",
   "turnin": "r20_human_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe and Elian will explain safe trees, shared timber and the first repair.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "r14_human_10_a_woodsman_s_edge",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Woodsman's Edge",
   "turnin": "r14_human_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Bess Honeycrust has a second oven ready for Dawnmere's returning field hands. Bring three coal lumps for its fuel store. Traded supplies count; mining natural coal yourself only requires a pickaxe; wood and stone picks work too.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
   "giver_settlement": "Dawnmere",
   "id": "r20_human_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Second Oven",
   "turnin": "r20_human_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick for a short lesson before the road leaves the soft fields.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "r14_human_11_a_pick_for_the_road",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_human_10_a_woodsman_s_edge"
   ],
   "reward_items": [],
   "title": "A Pick for the Road",
   "turnin": "r14_human_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "The granary's damaged braces leave the baskets open to pests. Bring six oak planks to repair the store frame. Boards already in your pack or obtained by trade count too.",
   "giver": "r14_human_elder",
   "giver_name": "Elian Reed",
   "giver_settlement": "Dawnmere",
   "id": "r14_human_03_granary_teeth",
