   "xp": 60
  },
  {
   "copper": 3,
   "description": "The Large Rats have chewed my grain sacks, and I intend to make them contribute to the repairs. Bring me two Rat Fur Patches from them in the Dawnmere Meadows after dark; any you saved from your hunt will do. Yes, we are patching rat holes with rat fur. I call that good housekeeping.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
