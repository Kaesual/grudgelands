   "turnin": "r14_human_elder",
   "xp": 165
  },
  {
   "copper": 4,
   "description": "Bring ten cuts of Raw Meat from your hunts to my kitchen here in Dawnmere; anything you saved already counts. Boars and foxes provide it by day, rats after dark, and I have mouths to feed at every hour. I will cook a share for you to take along. Heroes run on supper, whatever the songs say.",
   "giver": "r20_human_start_cook",
   "giver_name": "Bess Honeycrust",
