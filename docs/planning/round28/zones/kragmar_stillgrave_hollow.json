   "reward_items": [
    "grug_smelting:dual_furnace 1"
   ],
   "title": "An Introduction in the Furnace",
   "turnin": "r14_undead_elder",
   "xp": 110
  },
  {
   "copper": 4,
   "description": "For once, my shopping can be done in daylight. Bring me two Crab Legs from the Small Crabs on the Stillgrave Saltbones west of Stillgrave, and one Fine Sinew from the Young Gaunt Stags on the Stillgrave Blightmoor by day. I have a broth to finish and brine sacks to tie shut; separate tasks, despite what you may have heard about my cooking.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_pantry_02",
   "min_level": 6,
