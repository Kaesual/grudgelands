    {
     "count": 5,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [
    "stillgrave_kitchen_01"
   ],
   "reward_items": [],
   "title": "A Little Warmth, Professionally",
   "turnin": "r20_undead_start_cook",
   "xp": 60
  },
  {
   "copper": 3,
   "description": "Take your wooden pick to plain rock in the hills outside town, then make a Stone Axe and a Stone Pickaxe. Bring me both and I will return a pair after inspection. If the rock has a name and two dates on it, find another rock.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_tools_02",
   "min_level": 2,
