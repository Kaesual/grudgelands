   ],
   "reward_items": [],
   "title": "The Moor Changes Tenants",
   "turnin": "r14_undead_elder",
   "xp": 193
  },
  {
   "copper": 4,
   "description": "Mine copper and tin, smelt them, and bring me three Copper Bars and three Tin Bars. I will give you a Dual Furnace so you can begin making bronze. The metals must share a fire; happily, they get along better than most families at a reading of the will.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_tools_03",
   "min_level": 5,
