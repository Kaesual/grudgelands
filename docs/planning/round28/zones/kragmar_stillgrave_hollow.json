 "quests": [
  {
   "copper": 10,
   "description": "Plague boars churn Stillgrave's outer furrows by day. Drive off three before the retaining stones loosen, and take spare raw meat to Neral Saltkeeper by the oven.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_01_boars_in_the_dead_furrows",
   "min_level": 1,
   "objectives": [
    "kill 3 plague_boar or small_boar"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "mobs": [
      "grug_mobs:plague_boar",
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Boars in the Dead Furrows",
   "turnin": "r14_undead_elder",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "The shared oven feeds everyone returning from stillgrave's outer paths. Bring four raw meat portions to Neral Saltkeeper beside the oven. Take this provision job before the short local hunt; carried or traded meat counts, and Cooking is not required.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_02_salt_for_what_remains",
   "min_level": 1,
   "objectives": [
    "bring 4 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 4,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Salt for What Remains",
   "turnin": "r20_undead_start_cook",
   "xp": 20
  },
  {
   "copper": 10,
   "description": "Bring a wood axe so Veyra can show how living handles are kept sound in dead soil.\n\nOpen Basics in your Crafting tab to see the wood axe recipe: three planks and two sticks. You can make planks from a tree trunk and sticks from planks. Wood tools are fragile; stone lasts longer and bronze is your first durable upgrade. This lesson is optional; an axe made by a friend is welcome too.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_10_a_handle_that_will_not_rot",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:axe_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Handle That Will Not Rot",
   "turnin": "r14_undead_elder",
   "xp": 15
  },
  {
   "copper": 10,
   "description": "Neral Saltkeeper warms Stillgrave's salting room from the oven beside the common table. Bring three coal lumps to keep the damp out. Traded fuel counts; if you mine coal yourself, bring a pickaxe; wood and stone picks work too.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "r20_undead_start_cook",
   "min_level": 1,
   "objectives": [
    "bring 3 default:coal_lump"
   ],
   "objectives_raw": [
    {
     "count": 3,
     "item": "default:coal_lump",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Salt Against the Damp",
   "turnin": "r20_undead_start_cook",
   "xp": 20
  },
  {
   "copper": 15,
   "description": "Bring a stone pick for a lesson in separating useful rock from a sealed grave.\n\nUse Basics to make a wooden pick first, then mine stone. The stone pick recipe uses three stone blocks across the top and two sticks down the middle. Keep valuable tools repaired through a profession trainer in a settlement. This lesson is optional; a traded pick counts too.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_11_a_pick_among_headstones",
   "min_level": 2,
   "objectives": [
    "bring 1 grug_materials:pick_stone"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:pick_stone",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_undead_10_a_handle_that_will_not_rot"
   ],
   "reward_items": [],
   "title": "A Pick Among Headstones",
   "turnin": "r14_undead_elder",
   "xp": 45
  },
  {
   "copper": 20,
   "description": "The crypt stores need dry shelves above the damp soil. Bring six gravewood planks, the ordinary boards cut from this region's gravewood trunks. Existing or traded boards count; nothing must be taken from a protected tomb.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_03_gnawing_in_the_crypt_stores",
   "min_level": 3,
   "objectives": [
    "bring 6 grug_trees:gravewood_wood"
   ],
   "objectives_raw": [
    {
     "count": 6,
     "item": "grug_trees:gravewood_wood",
     "type": "item"
    }
   ],
   "prerequisites": [
    "r14_undead_01_boars_in_the_dead_furrows"
   ],
   "reward_items": [],
   "title": "Dry Shelves for the Crypt Stores",
   "turnin": "r14_undead_elder",
   "xp": 100
  },
  {
   "copper": 25,
   "description": "Three uncalled zombies have wandered into Stillgrave's outer furrows. The patrol sets out after nightfall, although blight-ground zombies can linger through daylight too. Seek level-3-and-up ground; the store repairs do not depend on this patrol.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "r14_undead_04_the_uncalled_dead",
   "min_level": 4,
