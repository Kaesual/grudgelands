   "reward_items": [],
   "title": "No Names to Call Them By",
   "turnin": "r14_undead_elder",
   "xp": 158
  },
  {
   "copper": 3,
   "description": "Our shroud sacks have begun returning their contents to the floor. Bring me two Rat Fur Patches from the Large Grave Rats in the Stillgrave Dead Furrows; anything you saved from your night hunt will do. Keep the spares for your armour enchants, and let me worry about dressing the storage.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_pantry_01",
   "min_level": 3,
   "objectives": [
    "bring 2 grug_mobs:rat_fur_patch"
   ],
   "objectives_raw": [
    {
     "count": 2,
     "item": "grug_mobs:rat_fur_patch",
     "type": "item"
    }
   ],
   "prerequisites": [
    "stillgrave_hunt_02"
   ],
   "reward_items": [],
   "title": "A Sack Ought to Hold Something",
   "turnin": "r20_undead_start_cook",
   "xp": 60
  },
  {
   "copper": 4,
   "description": "Bring me ten Raw Meat from the boars and rats around Stillgrave; whatever you kept from your hunts is welcome. A mourner may insist they cannot face a meal, but I still leave a bowl within reach. You shall have some cooked meat for the road, too; I dislike sending anyone away empty.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_kitchen_03",
   "min_level": 4,
   "objectives": [
    "bring 10 mobs:meat_raw"
   ],
   "objectives_raw": [
    {
     "count": 10,
     "item": "mobs:meat_raw",
     "type": "item"
    }
   ],
   "prerequisites": [
