    "stillgrave_hunt_03"
   ],
   "reward_items": [
    "mobs:meat 3"
   ],
   "title": "Mourning Is Hungry Work",
   "turnin": "r20_undead_start_cook",
   "xp": 100
  },
  {
   "copper": 7,
   "description": "Watch the Stillgrave Blightmoor, which lies in the west of Stillgrave Hollow, at dusk: the grazing stops, and then the squealing begins. Kill eight Aggressive Grave Rats there after dark; they attack on sight and call others into the fight. The Young Gaunt Stags graze there by day, and I have no complaint against them to add to your duties.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_hunt_04",
