      "grug_mobs:large_rat"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "stillgrave_hunt_01"
   ],
   "reward_items": [],
   "title": "Family Comes Running",
   "turnin": "r14_undead_elder",
   "xp": 105
  },
  {
   "copper": 3,
   "description": "Bring me five Coal Lumps from the rock outside Stillgrave; you can mine while you wait for nightfall. The public oven by my table takes coal in the fuel slot and raw food in the cooking slot. Mixing those up is how we discovered a meal even the dead would send back.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_kitchen_02",
   "min_level": 2,
   "objectives": [
    "bring 5 default:coal_lump"
   ],
