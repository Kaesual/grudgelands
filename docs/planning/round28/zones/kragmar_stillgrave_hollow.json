 "quests": [
  {
   "copper": 6,
   "description": "Small Plague Boars spend their days rooting through the Stillgrave Dead Furrows near Stillgrave, scattering people I took considerable trouble to bury. Kill eight; their yellow names mean they will leave you alone until you strike. Someone is also stealing bones, but let us begin with the offenders who cannot carry a sack.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_hunt_01",
   "min_level": 1,
   "objectives": [
    "kill 8 small_boar [in kragmar_stillgrave_hollow/dead_furrows]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_stillgrave_hollow/dead_furrows",
     "count": 8,
     "mobs": [
      "grug_mobs:small_boar"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "Please Leave the Residents Buried",
   "turnin": "r14_undead_elder",
   "xp": 105
  },
  {
   "copper": 2,
   "description": "The fire beneath my brine pot has gone out, and glaring at it has achieved very little. Bring me five logs from any tree outside Stillgrave's warded ground; logs, please, not planks. Death excuses a great many appetites, but apparently a fire's is not among them.",
   "giver": "r20_undead_start_cook",
   "giver_name": "Neral Saltkeeper",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_kitchen_01",
   "min_level": 1,
   "objectives": [
    "bring 5 group:tree"
   ],
   "objectives_raw": [
    {
     "count": 5,
     "group": "tree",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Fire Still Eats",
   "turnin": "r20_undead_start_cook",
   "xp": 30
  },
  {
   "copper": 2,
   "description": "Make a Wooden Axe and a Wooden Pickaxe and bring them to me for inspection. I will give you a pair in return; even a second life deserves a proper start. Mind your fingers while you work, especially any you have only recently acquired.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_tools_01",
   "min_level": 1,
   "objectives": [
    "bring 1 grug_materials:axe_wood",
    "bring 1 grug_materials:pick_wood"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_materials:axe_wood",
     "type": "item"
    },
    {
     "count": 1,
     "item": "grug_materials:pick_wood",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [
    "grug_materials:axe_wood 1",
    "grug_materials:pick_wood 1"
   ],
   "title": "Hands to Work",
   "turnin": "r14_undead_elder",
   "xp": 30
  },
  {
   "copper": 6,
   "description": "At night the Large Grave Rats take over the Stillgrave Dead Furrows, and the sound of their teeth carries all the way to my chair. Kill eight after dark. Pick your fights well apart: one squeal brings the relatives, who are distressingly prompt about visiting.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_hunt_02",
   "min_level": 2,
   "objectives": [
    "kill 8 large_rat [in kragmar_stillgrave_hollow/dead_furrows]"
   ],
   "objectives_raw": [
    {
     "area": "kragmar_stillgrave_hollow/dead_furrows",
     "count": 8,
