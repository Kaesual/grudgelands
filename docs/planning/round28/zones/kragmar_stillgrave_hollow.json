   "turnin": "r14_undead_elder",
   "xp": 130
  },
  {
   "copper": 9,
   "description": "Our missing bones have led us to the Stillgrave Robbers' Camp west from here, where Confused Grave Robber Chief Borrow has been treating the graves as a lending library. Kill six Confused Grave Robbers and their chief. Confusion might excuse digging the wrong hole once; arriving with sacks suggests a settled intention.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_hunt_05",
   "min_level": 8,
