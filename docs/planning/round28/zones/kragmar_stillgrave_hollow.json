   ],
   "reward_items": [],
   "title": "Broth and Loose Ends",
   "turnin": "r20_undead_start_cook",
   "xp": 120
  },
  {
   "copper": 4,
   "description": "Use your Dual Furnace to alloy three Bronze Bars and bring them to me. There is a Bronze Pickaxe waiting for you, for the harder rock beyond Stillgrave. I cannot go along to see how you fare, but I can at least see you properly equipped.",
   "giver": "r14_undead_elder",
