   "title": "Leave the Headstones",
   "turnin": "r14_undead_elder",
   "xp": 60
  },
  {
   "copper": 7,
   "description": "Braindead Zombies wander the Stillgrave Ashfields, which lies in the north of Stillgrave Hollow, raised without anyone to remember who they were. I have read the burial rolls aloud; not one turned its head. Lay eight to rest, by day or night. The blight soil shelters them from the sun, so waiting for dawn is no kindness.",
   "giver": "r14_undead_elder",
   "giver_name": "Veyra Pall",
   "giver_settlement": "Stillgrave",
   "id": "stillgrave_hunt_03",
   "min_level": 3,
   "objectives": [
