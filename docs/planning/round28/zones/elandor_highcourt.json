 "pvp_rule": "peaceful",
 "quests": [
  {
   "copper": 38,
   "description": "There are Debtbound Zombies wandering the Highcourt Commons, in the southeast of Highcourt, at night, still burdened with somebody's unpaid tolls. Put five to rest after dark. Penn's name keeps appearing in the complaints, and I intend to learn why. Highcourt can surely spare the dead another demand for payment.",
   "giver": "r20_human_capital_envoy",
   "giver_name": "Mariel Waybook",
   "giver_settlement": "Highcourt",
   "id": "highcourt_accounts_01",
   "min_level": 19,
   "objectives": [
    "kill 5 debtbound_zombie [in elandor_highcourt/commons]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_highcourt/commons",
     "count": 5,
     "mobs": [
      "grug_mobs:debtbound_zombie"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "The Dead Cannot Owe Toll",
   "turnin": "r20_human_capital_envoy",
   "xp": 390
  },
  {
   "copper": 13,
   "description": "I paid for river baskets and received a very confident promise, which has proved difficult to put bread in. Find Merren Oakstamp at Whitebridge Market Close in Whitebridge Shire and ask what became of my order. Follow the road, or visit the stables about a mount if your feet have already lodged a complaint.",
   "giver": "r20_human_capital_cook",
   "giver_name": "Ansel Ovenward",
   "giver_settlement": "Highcourt",
   "id": "highcourt_dispatch_01",
   "min_level": 21,
   "objectives": [
    "talk to Merren Oakstamp (r20_anchor_016)"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "npc": "r20_anchor_016_host",
     "type": "talk"
    }
   ],
   "prerequisites": [
    "highcourt_accounts_01"
   ],
   "reward_items": [],
   "title": "The Empty River Baskets",
   "turnin": "r20_anchor_016_host",
   "xp": 135
  },
  {
   "copper": 19,
   "description": "My bread board rocks, and the royal kitchen has offered to lend me a peg with more conditions than a peace treaty. Bring me one Gnarled Boar Tusk from a Furrow Boar by day on the Highcourt Commons, which lies in the southeast of Highcourt. Their yellow names mean they only fight back when struck. I would rather settle the matter with the boar.",
   "giver": "r20_human_capital_cook",
   "giver_name": "Ansel Ovenward",
   "giver_settlement": "Highcourt",
   "id": "highcourt_provisions_01",
   "min_level": 21,
   "objectives": [
    "bring 1 grug_mobs:gnarled_boar_tusk"
   ],
   "objectives_raw": [
    {
     "count": 1,
     "item": "grug_mobs:gnarled_boar_tusk",
     "type": "item"
    }
   ],
   "prerequisites": [],
   "reward_items": [],
   "title": "A Peg for the Bread Board",
   "turnin": "r20_human_capital_cook",
   "xp": 203
  },
  {
   "copper": 38,
   "description": "The palace has ordered venison for a banquet and left the hunting to whoever happens to be standing near my oven. Bring down six Moss-Antler Stags by day on the Highcourt Commons. Their yellow names mean they only fight back when struck, which is more patience than the banquet guests will show.",
   "giver": "r20_human_capital_cook",
   "giver_name": "Ansel Ovenward",
   "giver_settlement": "Highcourt",
   "id": "highcourt_provisions_venison",
   "min_level": 21,
   "objectives": [
    "kill 6 moss_antler_stag [in elandor_highcourt/commons]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_highcourt/commons",
     "count": 6,
