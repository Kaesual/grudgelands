      "grug_mobs:moss_antler_stag"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "highcourt_provisions_01"
   ],
   "reward_items": [],
   "title": "Optional: Venison for the Long Table",
   "turnin": "r20_human_capital_cook",
   "xp": 405
  },
  {
   "copper": 38,
   "description": "The complaints lead to Toll Bandit Archers in the Highcourt Deer Park southwest of Highcourt, collecting after dark from anyone unfortunate enough to pass. Defeat five there at night. Their badges claim royal authority; the crown's instructions do not include shooting customers.",
   "giver": "r20_human_capital_envoy",
   "giver_name": "Mariel Waybook",
   "giver_settlement": "Highcourt",
   "id": "highcourt_accounts_02",
   "min_level": 24,
   "objectives": [
    "kill 5 toll_bandit_archer [in elandor_highcourt/deer_park]"
   ],
   "objectives_raw": [
    {
     "area": "elandor_highcourt/deer_park",
     "count": 5,
     "mobs": [
      "grug_mobs:toll_bandit_archer"
     ],
     "type": "kill"
    }
   ],
   "prerequisites": [
    "highcourt_accounts_01"
   ],
   "reward_items": [],
   "title": "An Arrow Is Not a Receipt",
   "turnin": "r20_human_capital_envoy",
   "xp": 450
  },
  {
   "copper": 38,
   "description": "The petitions now include Tithe Revenants in the Highcourt Orchards, which lie in the west of Highcourt. They rise at night to demand payments nobody remembers owing. Lay five of them to rest after dark. I would prefer the dead stop collecting before the living start believing them.",
   "giver": "r20_human_capital_envoy",
   "giver_name": "Mariel Waybook",
   "giver_settlement": "Highcourt",
   "id": "highcourt_accounts_tithes",
   "min_level": 24,
   "objectives": [
    "kill 5 stubborn_zombie [in elandor_highcourt/orchards]"
   ],
   "objectives_raw": [
