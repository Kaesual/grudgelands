   ],
   "reward_items": [],
   "title": "Bread for the March",
   "turnin": "r20_anchor_031_host",
   "xp": 170
  },
  {
   "copper": 600,
   "description": "The crown's chart of Stormscale Summit, northeast from here across the water, has more empty space than I'm comfortable signing. Take a boat from the coast; the Shipwright at the stables sells them. Follow the shelf and the channel to avoid the Kraken in deep water, then defeat six Last Watchmen on the Stormscale Wreck Shore after dark. I'd like the next expedition to find somewhere to land, and you to come home to your payment.",
   "giver": "r20_human_capital_envoy",
   "giver_name": "Mariel Waybook",
   "giver_settlement": "Highcourt",
   "id": "highcourt_front_01",
   "min_level": 60,
   "objectives": [
