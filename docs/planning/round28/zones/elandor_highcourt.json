   ],
   "reward_items": [],
   "title": "Optional: Tithes After Dark",
   "turnin": "r20_human_capital_envoy",
   "xp": 465
  },
  {
   "copper": 38,
   "description": "The palace expects fruit pies, while the pickers expect to keep their fingers; I find the second request entirely reasonable. Hunt five Redfang Vixens by day in the Highcourt Orchards, which lie in the west of Highcourt. Mind their red names: they start fights, unlike the Orchard Foxes sharing that ground.",
   "giver": "r20_human_capital_cook",
   "giver_name": "Ansel Ovenward",
   "giver_settlement": "Highcourt",
   "id": "highcourt_provisions_02",
   "min_level": 24,
   "objectives": [
