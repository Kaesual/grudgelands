   "reward_items": [],
   "title": "Pies Have Consequences",
   "turnin": "r20_human_capital_cook",
   "xp": 450
  },
  {
   "copper": 51,
   "description": "Bandit Tollmaster Penn conducts his business at the Highcourt Toll Camp west from here, with enough borrowed ceremony to embarrass a coronation. Defeat five Toll Bandit Archers there and then Penn himself; his camp operates day and night. Keep clear of the other archers while you close on each one. I want him to discover that stamping a demand does not make it lawful.",
   "giver": "r20_human_capital_envoy",
   "giver_name": "Mariel Waybook",
   "giver_settlement": "Highcourt",
   "id": "highcourt_accounts_03",
   "min_level": 27,
   "objectives": [
    "kill 5 toll_bandit_archer [in elandor_highcourt/toll_camp]",
