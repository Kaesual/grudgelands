   "title": "The Last Unauthorised Stamp",
   "turnin": "r20_human_capital_envoy",
   "xp": 680
  },
  {
   "copper": 26,
   "description": "The gardeners are replanting the Highcourt Outer Fields, in the northwest of Highcourt, yet again, and the Razorbacks appear to regard this as attentive service. Bring down six by day and return for your bounty. I can pay for another hunt twenty-five minutes after you turn this one in.",
   "giver": "r20_human_capital_cook",
   "giver_name": "Ansel Ovenward",
   "giver_settlement": "Highcourt",
   "id": "highcourt_bounty_razorbacks",
   "min_level": 27,
   "objectives": [
