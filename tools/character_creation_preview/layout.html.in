<script>__THREE__</script>
<script>
"use strict";
const D=__DATA__;
__PORTRAIT__
const $=id=>document.getElementById(id);
const RACES={
human:{name:"Human",faction:"accord",place:"The open plains",description:"From open fields and busy roads, humans carry the spirit of the central plains into the wider world.",passive:"+10% quest XP",scale:1},
dwarf:{name:"Dwarf",faction:"accord",place:"The western pine hills",description:"Among western pine hills and old stone, dwarves make their homes. Toughness is a way of life.",passive:"Thick Skin · +5% armor rating",scale:.90},
elf:{name:"Elf",faction:"accord",place:"The deep eastern forests",description:"Keepers of the deep eastern forests, elves watch the paths beneath the canopy and the world beyond.",passive:"+3 m ability range",scale:1.06},
orc:{name:"Orc",faction:"throng",place:"The central savanna",description:"Raised beneath the wide savanna sky, orcs meet hardship head-on. Every blow gives them another reason to fight.",passive:"+1 rage per hit taken",scale:1.08},
troll:{name:"Troll",faction:"throng",place:"The eastern jungle",description:"Hunters of the eastern wilds, trolls know the tangled paths of the jungle and how to recover between battles.",passive:"+50% mana regeneration out of combat · +50% food healing",scale:1.12},
undead:{name:"Undead",faction:"throng",place:"The blighted west",description:"Risen from the blighted western lands, the undead walk among the remnants of another life — and choose what comes next.",passive:"Zombies and husks leave you alone unless attacked",scale:.94}
};
const CLASSES={warrior:{name:"Warrior",role:"Melee · Tank",description:"Meet your enemies head-on. Build rage through battle and hold the front line for your companions."},mage:{name:"Mage",role:"Ranged · Spell damage",description:"Command fire and frost from a distance. Strike hard, control the fight and keep danger out of reach."},priest:{name:"Priest",role:"Healing · Spell damage",description:"Mend wounds and shelter your allies, or turn your faith into a weapon against your enemies."},scout:{name:"Scout",role:"Ranged · Melee",description:"Hunt with a bow or close in with a blade. Survive through movement, timing and a well-placed strike."}};
const CATS=["tone","hair","style","eyes","feature"], LABELS={tone:"Skin tone",hair:"Hair colour",style:"Hairstyle",eyes:"Eyes",feature:"Feature"};
let race=null,cls="warrior",look={tone:0,hair:0,style:0,eyes:0,feature:0},yaw=.22,renderer,scene,root,camera,material,texture,toastTimer,groundShadow;
const imageCache={};
const ready=Promise.all(Object.entries(D.images).filter(([key])=>key.endsWith(".png")||key.startsWith("background_")).map(([key,src])=>new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>{imageCache[key]=im;resolve()};im.onerror=reject;im.src=src}))).catch(()=>notify("A preview texture could not be loaded."));
function icon(key,alt=""){return `<img class="icon" src="${D.images[key]}" alt="${alt}">`}
for(const [id,r] of Object.entries(RACES)){$(r.faction+"-races").insertAdjacentHTML("beforeend",`<button class="race" data-race="${id}" aria-pressed="false">${icon("race_"+id)}<span>${r.name}</span></button>`)}
for(const [id,c] of Object.entries(CLASSES)){$("class-grid").insertAdjacentHTML("beforeend",`<button class="class-choice" data-class="${id}" disabled aria-pressed="false">${icon("class_"+id)}<span>${c.name}</span></button>`)}
$("banner-accord").src=D.images.banner_accord;$("banner-throng").src=D.images.banner_throng;
function landscape(id){
 document.querySelector(".stage").classList.toggle("calibrated",!!D.portraits[id]);
 if(id){$("landscape").innerHTML=`<img src="${D.images["background_"+id]}" alt="" style="width:100%;height:100%;object-fit:cover;display:block">`}
 else{$("landscape").innerHTML="";$("landscape").style.background="radial-gradient(ellipse at 50% 35%,#52665c,#152725 70%)"}
}
function buildModel(){
 try{
 renderer=new THREE.WebGLRenderer({canvas:$("model"),alpha:true,antialias:true,preserveDrawingBuffer:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setClearColor(0x000000,0);
 scene=new THREE.Scene();scene.add(new THREE.HemisphereLight(0xfff6df,0x59634d,.95));const sun=new THREE.DirectionalLight(0xffedd0,.65);sun.position.set(-25,50,45);scene.add(sun);const rim=new THREE.DirectionalLight(0xd0e3df,.25);rim.position.set(30,15,-30);scene.add(rim);
 root=new THREE.Group();scene.add(root);material=new THREE.MeshLambertMaterial({alphaTest:.5});
 // Same body catalogue and classic box unwrap as tools/r54_armor/render.py.
 for(const b of D.body){const [x0,y0,z0,x1,y1,z1]=b.box,[u,v]=b.uv,[w,h,d]=b.dims;const geo=new THREE.BoxGeometry(x1-x0,y1-y0,z1-z0),regs=[[u+d+w,v+d,d,h],[u,v+d,d,h],[u+d,v,w,d],[u+d+w,v,w,d],[u+d,v+d,w,h],[u+2*d+w,v+d,w,h]],uv=geo.attributes.uv;
 for(let f=0;f<6;f++){const [rx,ry,rw,rh]=regs[f];for(let k=0;k<4;k++){let i=f*4+k;uv.setXY(i,(rx+uv.getX(i)*rw)/64,1-(ry+(1-uv.getY(i))*rh)/32)}}
 const mesh=new THREE.Mesh(geo,material);mesh.position.set((x0+x1)/2,(y0+y1)/2,(z0+z1)/2);root.add(mesh);if(b.mirror){const copy=mesh.clone();copy.position.x=-copy.position.x;copy.scale.x=-1;root.add(copy)}}
 // A soft contact shadow in the same ground plane as the saved scene.
 const shadowCanvas=document.createElement('canvas');shadowCanvas.width=128;shadowCanvas.height=128;
 const shadowContext=shadowCanvas.getContext('2d'),gradient=shadowContext.createRadialGradient(64,64,8,64,64,64);
 gradient.addColorStop(0,'rgba(0,0,0,.38)');gradient.addColorStop(.4,'rgba(0,0,0,.22)');gradient.addColorStop(1,'rgba(0,0,0,0)');shadowContext.fillStyle=gradient;shadowContext.fillRect(0,0,128,128);
 groundShadow=new THREE.Mesh(new THREE.PlaneGeometry(1.25,.85),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(shadowCanvas),transparent:true,depthWrite:false}));
 groundShadow.rotation.x=-Math.PI/2;groundShadow.visible=false;scene.add(groundShadow);
 camera=new THREE.PerspectiveCamera(32,1,.05,300);camera.position.set(0,18,69);camera.lookAt(0,16,0);root.visible=false;
 new ResizeObserver(draw).observe(document.querySelector(".stage"));new ResizeObserver(draw).observe($("model-area"));draw();
 }catch(e){$("model").classList.add("hidden");$("rotate").textContent="3D preview needs WebGL in your browser.";renderer=null;console.error(e)}
}
function draw(){
 if(!renderer)return;
 const portrait=D.portraits[race],a=portrait?$('landscape'):$('model-area'),rect=a.getBoundingClientRect(),w=rect.width,h=rect.height;
 if(!w||!h)return;
 renderer.setSize(w,h,false);groundShadow.visible=!!portrait&&root.visible;
 if(portrait){
  fitPortraitCamera(camera,portrait.spec,w,h,portrait.width,portrait.height);
  placePortrait(root,portrait.spec,portrait.spec.portrait.stature,yaw);
  const [x,y,z]=portrait.spec.portrait.feet;groundShadow.position.set(x,y+.003,-z);
 }else{
  camera.fov=32;camera.aspect=w/h;camera.position.set(0,18,69);camera.lookAt(0,16,0);camera.updateProjectionMatrix();
  root.position.set(0,0,0);root.scale.setScalar(race?RACES[race].scale:1);root.rotation.y=yaw;
 }
 renderer.render(scene,camera);
}
function skin(){if(!race||!renderer)return;const def=D.looks[race],c=document.createElement("canvas");c.width=64;c.height=32;const ctx=c.getContext("2d");
 function layer(name,tint){const im=imageCache[name];if(!im)return;const temp=document.createElement("canvas");temp.width=64;temp.height=32;const tc=temp.getContext("2d");tc.drawImage(im,0,0);if(tint){const pixels=tc.getImageData(0,0,64,32),rgb=[1,3,5].map(i=>parseInt(tint.slice(i,i+2),16));for(let i=0;i<pixels.data.length;i+=4)for(let k=0;k<3;k++)pixels.data[i+k]=Math.floor(pixels.data[i+k]*rgb[k]/255);tc.putImageData(pixels,0,0)}ctx.drawImage(temp,0,0)}
 layer("grug_visuals_skin_mask.png",def.tones[look.tone]);layer(def.body);layer(def.eyes_mask,def.eyes[look.eyes]);const hair=def.styles[look.style];layer(hair.mask,def.hair[look.hair]);layer(hair.detail);const feat=def.features[look.feature];if(feat.mask)layer(feat.mask,feat.tint==="tone"?def.tones[look.tone]:def.hair[look.hair]);layer(feat.detail);
 if(texture)texture.dispose();texture=new THREE.CanvasTexture(c);texture.magFilter=THREE.NearestFilter;texture.minFilter=THREE.NearestFilter;texture.generateMipmaps=false;material.map=texture;material.needsUpdate=true;root.visible=true;root.scale.setScalar(RACES[race].scale);draw();}
function controls(){const def=race?D.looks[race]:D.looks.human;$("looks").innerHTML=CATS.map(key=>{let label=LABELS[key];if(key==="feature"&&race)label={human:"Beard",dwarf:"Beard",elf:"Ears",orc:"Tusks",troll:"Tusks",undead:"Face"}[race];if(key==="eyes"&&race==="undead")label="Eye glow";const options=def.options[key],val=options[look[key]],color=typeof val==="string"?val:null,text=race?(color?`${look[key]+1} / ${options.length}`:val.name):"—";return `<div class="look-row"><label>${label}</label><button data-look="${key}" data-delta="-1" ${race?"":"disabled"} aria-label="Previous ${label}">‹</button><span class="look-value">${race&&color?`<i class="swatch" style="background:${color}"></i>`:""}${text}</span><button data-look="${key}" data-delta="1" ${race?"":"disabled"} aria-label="Next ${label}">›</button></div>`}).join("");$("looks").classList.toggle("disabled",!race);$("random").disabled=!race;}
function showClass(){document.querySelectorAll("[data-class]").forEach(b=>{b.classList.toggle("active",!!race&&b.dataset.class===cls);b.setAttribute("aria-pressed",String(!!race&&b.dataset.class===cls));b.disabled=!race});$("classes").classList.toggle("locked",!race);if(!race){$("class-title").textContent="Your calling";$("class-role").textContent="";$("class-description").textContent="Your class shapes how you fight and support your companions.";$("skills").innerHTML="";$("skill-footer").classList.add("hidden");return}const c=CLASSES[cls];$("class-title").textContent=c.name;$("class-role").textContent=c.role;$("class-description").textContent=c.description;let groups=[...new Set(D.skills[cls].map(s=>s.group))];$("skills").innerHTML=groups.map(g=>`<div class="skill-group">${g}</div>`+D.skills[cls].filter(s=>s.group===g).map(s=>`<div class="skill">${icon("skill_"+s.id)}<span>${s.name}</span></div>`).join("")).join("");$("skills").scrollTop=0;$("skill-footer").classList.remove("hidden");}
function summary(){ $("summary").innerHTML=race?`<b>${RACES[race].name}</b><span>·</span>${CLASSES[cls].name}<span>·</span>The ${RACES[race].faction==="accord"?"Accord":"Throng"}`:"Your story starts with a choice.";$("create").disabled=!race;}
async function chooseRace(id){if(id===race)return;race=id;for(const key of CATS)look[key]=Math.floor(Math.random()*D.looks[id].options[key].length);yaw=.22;document.querySelectorAll("[data-race]").forEach(b=>{b.classList.toggle("active",b.dataset.race===race);b.setAttribute("aria-pressed",String(b.dataset.race===race))});const r=RACES[race];$("stage-faction").textContent="THE "+r.faction.toUpperCase();$("stage-race").textContent=r.name;$("stage-place").textContent=r.place;$("race-title").textContent=r.name;$("race-description").textContent=r.description;$("passive").textContent=r.passive;$("passive").classList.remove("hidden");$("empty").classList.add("hidden");$("shadow").style.opacity="1";$("rotate").style.visibility="visible";landscape(id);controls();showClass();summary();await ready;skin();}
function reset(){race=null;cls="warrior";look={tone:0,hair:0,style:0,eyes:0,feature:0};if(root){root.visible=false;draw()}document.querySelectorAll("[data-race]").forEach(b=>{b.classList.remove("active");b.setAttribute("aria-pressed","false")});$("stage-faction").textContent="A WORLD WAITING FOR YOU";$("stage-race").textContent="Your journey begins";$("stage-place").textContent="Six peoples. One world.";$("race-title").textContent="Your people";$("race-description").textContent="Choose a people to discover their home and their innate strength.";$("passive").classList.add("hidden");$("empty").classList.remove("hidden");$("shadow").style.opacity="0";$("rotate").style.visibility="hidden";landscape(null);controls();showClass();summary()}
function notify(text){clearTimeout(toastTimer);$("toast").textContent=text;$("toast").classList.remove("hidden");toastTimer=setTimeout(()=>$("toast").classList.add("hidden"),4200)}
document.addEventListener("click",async e=>{const rb=e.target.closest("[data-race]");if(rb){chooseRace(rb.dataset.race);return}const cb=e.target.closest("[data-class]");if(cb&&race){cls=cb.dataset.class;showClass();summary();return}const lb=e.target.closest("[data-look]");if(lb&&race){const key=lb.dataset.look,n=D.looks[race].options[key].length;look[key]=(look[key]+Number(lb.dataset.delta)+n)%n;controls();await ready;skin()}});
$("random").onclick=async()=>{if(!race)return;for(const key of CATS)look[key]=Math.floor(Math.random()*D.looks[race].options[key].length);controls();await ready;skin()};
$("reset").onclick=reset;$("create").onclick=()=>notify("Nur eine Vorschau: Hier würde dein Charakter erstellt werden.");$("banner-mode").onchange=e=>document.body.dataset.banner=e.target.value;
$("fullscreen").onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen()}catch{notify("Vollbild ist in dieser Ansicht nicht verfügbar. Öffne die HTML-Datei direkt im Browser.")}};
for(const id of ["notes","about"])$(id).onclick=()=>$("notes-dialog").showModal();$("close-notes").onclick=()=>$("notes-dialog").close();
let drag=null;$("model").onpointerdown=e=>{if(!race)return;drag=e.clientX;$("model").setPointerCapture(e.pointerId)};$("model").onpointermove=e=>{if(drag===null)return;yaw+=(e.clientX-drag)*.012;drag=e.clientX;draw()};$("model").onpointerup=$("model").onpointercancel=()=>drag=null;$("model").onkeydown=e=>{if(race&&["ArrowLeft","ArrowRight"].includes(e.key)){e.preventDefault();yaw+=e.key==="ArrowLeft"?-.16:.16;draw()}};
buildModel();reset();const initial=new URLSearchParams(location.search).get("race");if(RACES[initial])chooseRace(initial);window.previewReady=ready;
</script></body></html>
