<!doctype html>
<html lang="de">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Grudgelands · Wohn- und Berufsgebäude</title>
<style>
:root{color-scheme:dark;--paper:#e9e2d4;--muted:#a7b4b4;--line:#384447;--accent:#dfb878}
*{box-sizing:border-box}body{margin:0;background:#152125;color:var(--paper);font:15px/1.5 system-ui,sans-serif}
header{padding:26px 34px 18px;display:flex;gap:28px;align-items:end;justify-content:space-between;border-bottom:1px solid var(--line)}
.eyebrow{color:var(--accent);font-size:11px;font-weight:650;letter-spacing:.18em;text-transform:uppercase}h1{font:34px/1.12 Georgia,serif;margin:8px 0}header p{color:var(--muted);margin:0;font-size:13px;max-width:780px}.badge{font-size:11px;border:1px solid #61716c;color:#c3d3c2;padding:6px 10px;white-space:nowrap}
.cultures{display:flex;gap:8px;flex-wrap:wrap;padding:15px 34px 0}.cultures button{min-width:90px}.source{font-size:12px;color:var(--accent);margin-bottom:8px}nav{padding:15px 34px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}.group{display:flex;gap:5px;align-items:center}.group label{color:var(--muted);font-size:12px;margin-right:7px}
button,select{font:inherit;font-size:13px;color:var(--paper);background:#233136;border:1px solid #48565b;border-radius:4px;padding:8px 12px;cursor:pointer}button:hover,select:hover{border-color:var(--accent)}button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:#242b2d}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
#compare{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--line);border-block:1px solid var(--line)}.panel{position:relative;min-width:0}.stage{height:clamp(370px,58vh,760px);width:100%;overflow:hidden;background:#9ec3ea}.stage canvas{display:block;width:100%;height:100%;touch-action:none}.caption{position:absolute;left:20px;top:17px;background:#152125e8;border:1px solid #71808766;padding:7px 13px;pointer-events:none;font-size:12px;letter-spacing:.04em}.caption b{font-size:15px;margin-right:8px}.proposal b{color:var(--accent)}
.hint{padding:9px 34px;color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--line)}#picked{color:#d5c299;overflow-wrap:anywhere}
article{padding:23px 34px 30px;display:grid;grid-template-columns:1.05fr 1fr;gap:42px}h2{font:25px Georgia,serif;margin:0 0 9px}h3{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--accent);margin:0 0 12px}article p{color:#bdc8c7;font-size:14px;margin:0 0 12px;max-width:720px}ul{padding-left:18px;color:#bdc8c7;font-size:13px;margin:0}li{padding:3px 0}.swatches{display:flex;gap:14px;flex-wrap:wrap}.swatch{width:95px}.swatch img{width:70px;height:70px;image-rendering:pixelated;border:1px solid #7a8078}.swatch span{display:block;font-size:11px;line-height:1.4;color:#bdc8c7;margin-top:5px}footer{padding:14px 34px 24px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}#error{color:#ffb29f;white-space:pre-wrap}input[type=range]{width:115px;accent-color:var(--accent)}#cut-label{font-variant-numeric:tabular-nums;min-width:48px;font-size:12px}.mobile-only{display:none}
@media(max-width:850px){header{padding:20px;align-items:start}.badge{display:none}h1{font-size:28px}nav{padding:12px 20px;gap:12px}.group{flex-wrap:wrap}article{padding:22px 20px;gap:22px;grid-template-columns:1fr}.hint,footer{padding-inline:20px}#compare{grid-template-columns:1fr}.panel{display:none}.panel.active{display:block}.stage{height:52vh;min-height:350px}.mobile-only{display:flex}.swatch{width:82px}}
</style>
<header><div><div class="eyebrow">Grudgelands / Stadtgebäude · Übertragung</div><h1 id="culture-line">Stein trägt. Holz wärmt.</h1><p>Die gewählte Gestaltung auf weiteren Wohn- und Berufsgebäuden. Besondere Formen sind in der Übersicht markiert.</p></div><span class="badge">Lokaler Vergleich</span></header>
<div class="cultures" id="cultures" role="group" aria-label="Volk auswählen"></div>
<nav aria-label="Vergleich steuern">
 <div class="group"><label for="buildings">Gebäude</label><select id="buildings" style="max-width:min(600px,85vw)"></select></div>
 <div class="group"><label for="angle">Ansicht</label><select id="angle"><option value="corner">Gesamtansicht</option><option value="front">Eingang</option><option value="gable">Giebel</option><option value="back">Rückseite</option><option value="inside">Innenraum von oben</option></select><button id="reset" title="Gewählte Ansicht zurücksetzen">Zurücksetzen</button></div>
 <div class="group"><label for="cut">Schnitt</label><input id="cut" type="range" min="0" max="12" value="12"><span id="cut-label">Alles</span></div>
 <div class="group mobile-only"><button data-side="before" aria-pressed="false">Bestand</button><button data-side="after" aria-pressed="true">Vorschlag</button></div>
</nav>
<main>
 <div id="compare"><section class="panel" id="panel-before" aria-label="Bestand"><div id="before" class="stage"></div><div class="caption"><b>Bestand</b> Aktuelle Spielvorlage</div></section><section class="panel active" id="panel-after" aria-label="Vorschlag"><div id="after" class="stage"></div><div class="caption proposal"><b>Vorschlag</b> Gleiche Form, neue Materialordnung</div></section></div>
 <div class="hint"><span>Ziehen: drehen · Mausrad / zwei Finger: zoomen · Rechts ziehen: verschieben · Kameras gekoppelt</span><span id="picked" aria-live="polite">Block anklicken: Material ansehen</span></div>
 <article><section><div id="source" class="source"></div><h2 id="heading">Das Wohnhaus</h2><p id="description"></p><ul id="details"></ul><p id="error" role="alert"></p></section><section><h3>Materialien dieses Entwurfs</h3><div class="swatches" id="swatches"></div><p id="material-note" style="font-size:12px;margin-top:15px"></p></section></article>
</main>
<footer><a href="index.html" style="color:var(--accent)">Zur Gebäudeübersicht</a> · Studie mit dem vorhandenen Three.js-Gebäude-Renderer und echten Spieltexturen. Beleuchtung ist angenähert; keine Luanti-Aufnahme. Grundform, Fenster, Türen und Einrichtung bleiben erhalten. Erst nach deiner Auswahl folgt eine Übernahme in die Spielvorlagen.</footer>
<!-- __LICENSE__ -->
<script>__THREE__</script><script id="payload" type="application/json">__PAYLOAD__</script><script>
__ORBIT__
__RENDERER__
const D=JSON.parse(document.getElementById('payload').textContent),$=id=>document.getElementById(id);
let building='home',locked=false,ready=false,side='after';
const views={};
for(const key of ['before','after']){
 views[key]=createNodeView({stage:$(key),types:D.types,textures:D.textures,meshes:D.meshes,onPick:event=>{
   const hit=views[key].pick(event.clientX,event.clientY);
   if(hit&&hit.i>=0){const v=views[key],t=D.types[v.data.T[hit.i]];$('picked').textContent=`${key==='before'?'Bestand':'Vorschlag'} · ${t.name.startsWith('study:')?'Vorschauform · ':''}${t.name} · ${hit.x}, ${hit.y}, ${hit.z}`}
 }});
 views[key].controls.enableDamping=false;
 views[key].camera.fov=40;
 views[key].controls.addEventListener('change',()=>{
   if(locked||!ready)return;locked=true;
   const other=views[key==='before'?'after':'before'],p=views[key].pose();other.lookAt(p.pos,p.target);
   views[key].step(0);other.step(0);locked=false;
 });
}
function render(){locked=true;for(const v of Object.values(views))v.step(0);locked=false}
function fit(){for(const [key,v]of Object.entries(views)){const rect=$(key).getBoundingClientRect();if(!rect.width)continue;v.renderer.setPixelRatio(Math.min(devicePixelRatio,2));v.renderer.setSize(rect.width,rect.height);v.camera.aspect=rect.width/rect.height;v.camera.updateProjectionMatrix()}render()}
function preset(){
 const spec=D.buildings[building],which=$('angle').value;
 let eye,target;
 if(spec.reference==='home'||spec.reference==='forge'){
  // Keep the original two study cameras as well as their accepted material changes.
  const forge=spec.reference==='forge',cx=forge?7.5:4,cz=forge?7:4,span=forge?30:21;
  target=[cx,forge?4.2:3.8,cz];eye=[cx+span*.85,forge?14:11,cz-span];
  if(which==='front')eye=forge?[cx,6,cz+span*1.15]:[cx,5,cz-span*1.1];
  if(which==='gable')eye=forge?[5,7,-span*.85]:[-span*.9,6,cz];
  if(which==='back')eye=[cx-span*.85,forge?13:10,cz+span];
  if(which==='inside')eye=[cx+span*.35,span*1.1,cz-span*.5];
 }else{
  const cx=(spec.pivot[0]-1)/2,cz=(spec.pivot[1]-1)/2;
  const height=spec.max_y-spec.floor,span=Math.max(spec.size[0],spec.size[2],height*1.15)*1.65;
  const directions=[[0,-1],[-1,0],[0,1],[1,0]],front=directions[spec.front],right=[-front[1],front[0]];
  target=[cx,spec.floor+height*.43,cz];
  eye=[cx+front[0]*span+right[0]*span*.85,spec.floor+height*.95+2,cz+front[1]*span+right[1]*span*.85];
  if(which==='front'||which==='gable'){
   const d=directions[which==='front'?spec.front:spec.gable];eye=[cx+d[0]*span*1.15,spec.floor+height*.55,cz+d[1]*span*1.15];
  }
  if(which==='back')eye=[cx-front[0]*span-right[0]*span*.85,spec.floor+height*.9,cz-front[1]*span-right[1]*span*.85];
  if(which==='inside'){target=[cx,spec.floor+1,cz];eye=[cx+span*.35,spec.floor+span*1.1,cz-span*.5]}
 }
 locked=true;for(const v of Object.values(views))v.lookAt(eye,target);locked=false;render();
}
function setCut(value){
 const max=D.buildings[building].max_y,valueClamped=Math.min(max,Math.max(0,+value));
 $('cut').value=valueClamped;$('cut-label').textContent=valueClamped===max?'Alles':'y ≤ '+valueClamped;
 locked=true;for(const v of Object.values(views)){v.filter.cut=valueClamped;v.rebuild()}locked=false;render();
}
async function texturesReady(){
 const images=new Set();for(const v of Object.values(views))v.root.traverse(o=>{for(const m of Array.isArray(o.material)?o.material:[o.material])if(m?.map?.image)images.add(m.map.image)});
 await Promise.all([...images].map(im=>im.complete&&im.naturalWidth?Promise.resolve():im.decode()));
 await new Promise(r=>requestAnimationFrame(r));render();
}
async function showBuilding(key){
 if(!D.buildings[key])throw new Error('Unbekanntes Gebäude: '+key);
 ready=false;building=key;const spec=D.buildings[key];
 for(const button of document.querySelectorAll('[data-culture]'))button.setAttribute('aria-pressed',button.dataset.culture===spec.race);
 $('buildings').replaceChildren(...Object.entries(D.buildings).filter(([,s])=>s.race===spec.race).map(([k,s])=>{
  const option=document.createElement('option');option.value=k;option.textContent=s.town+' · '+s.label+(s.attention?' · Ansehen':'');
  option.selected=k===key;return option;
 }));
 $('culture-line').textContent=D.cultures[spec.race].line;
 $('source').textContent=D.cultures[spec.race].label+' · '+spec.town+(spec.template_races.length>1?' · Gemeinsam verwendete Vorlage':'');
 $('heading').textContent=spec.title;$('description').textContent=spec.description;
 $('details').replaceChildren(...spec.details.map(text=>{const li=document.createElement('li');li.textContent=text;return li}));
 $('swatches').replaceChildren(...spec.materials.map(m=>{
  const el=document.createElement('div');el.className='swatch';const image=document.createElement('img');image.src=m.image;image.alt=m.label;image.title=m.node;
  const label=document.createElement('span');label.textContent=m.label;el.append(image,label);return el;
 }));
 $('material-note').textContent=spec.race==='troll'?'Die Schilftextur existiert bereits im Spiel. Ihre Dachtreppen und Eckformen sind weiterhin reine Browser-Vorschauformen.':
  spec.reference?'Unverändertes Referenzgebäude aus der bisherigen Studie.':spec.profile+' · Gleiche Grundform, Öffnungen und Einrichtung.';
 for(const [variant,v]of Object.entries(views)){const scene=D.scenes[key+'_'+variant];v.setData(decodeCells(scene.cells,scene.count));}
 $('cut').max=spec.max_y;$('picked').textContent='Block anklicken: Material ansehen';
 setCut($('angle').value==='inside'?spec.inside_cut:spec.max_y);preset();fit();ready=true;
 const url=new URL(location.href);url.searchParams.set('building',key);history.replaceState(null,'',url);
 await texturesReady();return {building:key,camera:views.before.pose(),counts:[views.before.data.n,views.after.data.n]};
}
function showSide(key){side=key;for(const k of ['before','after'])$('panel-'+k).classList.toggle('active',key===k);for(const b of document.querySelectorAll('[data-side]'))b.setAttribute('aria-pressed',b.dataset.side===key);fit()}
for(const [race,spec]of Object.entries(D.cultures)){
 const b=document.createElement('button');b.dataset.culture=race;b.textContent=spec.label;b.setAttribute('aria-pressed','false');
 b.onclick=()=>showBuilding(Object.keys(D.buildings).find(k=>D.buildings[k].race===race)).catch(fail);$('cultures').append(b);
}
for(const b of document.querySelectorAll('[data-side]'))b.onclick=()=>showSide(b.dataset.side);
$('buildings').onchange=()=>showBuilding($('buildings').value).catch(fail);
$('angle').onchange=()=>{setCut($('angle').value==='inside'?D.buildings[building].inside_cut:D.buildings[building].max_y);preset()};$('reset').onclick=preset;$('cut').oninput=()=>setCut($('cut').value);
function fail(e){$('error').textContent='Die 3D-Ansicht konnte nicht geladen werden: '+e.message;console.error(e)}
addEventListener('resize',fit);
window.study={views,showBuilding,setCut,showSide,preset,fit,get building(){return building}};
const initial=new URLSearchParams(location.search).get('building');
window.studyReady=showBuilding(D.buildings[initial]?initial:Object.keys(D.buildings)[0]).catch(e=>{fail(e);throw e});
</script></html>
