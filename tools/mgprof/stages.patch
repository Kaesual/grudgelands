diff -ruN a/mods/MAPGEN/grug_mapgen/wp40/mgprof.lua b/mods/MAPGEN/grug_mapgen/wp40/mgprof.lua
--- a/mods/MAPGEN/grug_mapgen/wp40/mgprof.lua
+++ b/mods/MAPGEN/grug_mapgen/wp40/mgprof.lua
@@ -0,0 +1,323 @@
+-- MGPROF (lane MGPROF, throwaway): a per-stage timer for the R7 generated
+-- callback. Installed only into the staged game copy of a measuring boot by
+-- tools/mgprof/stages.patch; never shipped.
+--
+-- Stages are a flat timeline: mark(name) books the time since the previous
+-- mark (or begin) to `name`, so the stages of one callback sum exactly to its
+-- total. add(name, us) books a sub-timer that is ALSO inside some stage (a
+-- part of that stage, reported separately, not added to the sum). count()
+-- books plain counters. finish() writes one GRUG_MGPROF line per callback.
+-- With the setting grug_mgprof_totals_only = true (set by the probe in the
+-- main environment; g_settings is shared) only the callback total is taken:
+-- no stage marks, sub-timers or counters, for the instrumentation-overhead
+-- comparison. P.stages_on is read once, at the first callback.
+--
+-- Follow-up 2 additions:
+-- * SHA-256 accounting: install_sha() wraps core.sha256 (every mapgen digest
+--   ends there); while a callback is active each call's count, input bytes
+--   and time (difference of two us readings: unbiased in the sum, coarse per
+--   call) are pending and booked to the stage of the next mark ("h.<stage>").
+-- * LuaJIT trace diagnosis, only where jit.attach exists (a boot with
+--   secure.enable_security = false; the sandbox's jit table has no attach):
+--   trace starts, stops, aborts (reason and source:line), flushes, machine
+--   code size and address range, per callback and for the process, from the
+--   emerge environment's start on.
+-- * One-time benchmarks at the first callback (outside its timer): a tight
+--   loop (a JIT health probe), raw core.sha256 by input length, the r6_hash
+--   digest with 4/7/11 fields and an integer-hash stand-in.
+local now = core.get_us_time
+local P = {active = false, column_sources = {}, now = now}
+local stages, order, sub, counts, hashes = {}, {}, {}, {}, {}
+local started, last = 0, 0
+local cache_before = {0, 0, 0}
+local callbacks = 0
+local totals_only
+local heap_before = 0
+local pending_calls, pending_us, pending_bytes = 0, 0, 0
+
+-- SHA-256 accounting -------------------------------------------------------
+function P.install_sha()
+	local raw = core.sha256
+	core.sha256 = function(data, raw_output)
+		if not P.active then return raw(data, raw_output) end
+		local t0 = now()
+		local result = raw(data, raw_output)
+		pending_us = pending_us + (now() - t0)
+		pending_calls = pending_calls + 1
+		pending_bytes = pending_bytes + #data
+		return result
+	end
+	P.raw_sha256 = raw
+end
+
+-- Trace diagnosis -----------------------------------------------------------
+local jit_api = rawget(_G, "jit")
+local trace = {start = 0, stop = 0, abort = 0, flush = 0}
+local trace_before = {start = 0, stop = 0, abort = 0, flush = 0}
+local abort_reason, abort_reason_before = {}, {}
+local abort_where, abort_where_before = {}, {}
+local mcode_bytes, mcode_min, mcode_max = 0, math.huge, 0
+local stop_kind = {}
+if type(jit_api) == "table" and type(jit_api.attach) == "function" and
+		type(require) == "function" then
+	local ok_util, jutil = pcall(require, "jit.util")
+	local ok_vmdef, vmdef = pcall(require, "jit.vmdef")
+	if ok_util and type(jutil) == "table" then
+		local function reason_text(err, info)
+			if type(err) ~= "number" then return tostring(err) end
+			local fmt = ok_vmdef and vmdef.traceerr[err] or ("err" .. err .. " %s")
+			if fmt == "NYI: bytecode %s" and type(info) == "number" then
+				info = string.sub(vmdef.bcnames, 6 * info + 1, 6 * info + 6)
+			end
+			local ok, text = pcall(string.format, fmt, tostring(info))
+			return ok and text or fmt
+		end
+		local function where(func, pc)
+			local ok, fi = pcall(jutil.funcinfo, func, pc)
+			if not ok or type(fi) ~= "table" then return "?" end
+			local source = fi.source or "?"
+			source = source:match("([^/]+)$") or source
+			return source .. ":" .. tostring(fi.currentline or fi.linedefined or "?")
+		end
+		jit_api.attach(function(what, tr, func, pc, otr, oex)
+			trace[what] = (trace[what] or 0) + 1
+			if what == "abort" then
+				local reason = reason_text(otr, oex)
+				abort_reason[reason] = (abort_reason[reason] or 0) + 1
+				local key = reason .. " @ " .. where(func, pc)
+				abort_where[key] = (abort_where[key] or 0) + 1
+			elseif what == "stop" then
+				local ok, mcode, address = pcall(jutil.tracemc, tr)
+				if ok and type(mcode) == "string" then
+					mcode_bytes = mcode_bytes + #mcode
+					if address < mcode_min then mcode_min = address end
+					if address > mcode_max then mcode_max = address end
+				end
+				local ok_info, info = pcall(jutil.traceinfo, tr)
+				local kind = ok_info and type(info) == "table" and
+					tostring(info.linktype) or "?"
+				stop_kind[kind] = (stop_kind[kind] or 0) + 1
+			elseif what == "flush" then
+				mcode_bytes = 0
+			end
+		end, "trace")
+		P.trace_attached = true
+		P.vmdef_loaded = ok_vmdef
+	end
+end
+
+local function cache_totals()
+	local hits, misses, evictions = 0, 0, 0
+	for index = 1, #P.column_sources do
+		local h, m, e = P.column_sources[index]()
+		hits, misses, evictions = hits + h, misses + m, evictions + e
+	end
+	return hits, misses, evictions
+end
+
+local function sorted_keys(map)
+	local keys = {}
+	for key in pairs(map) do keys[#keys + 1] = key end
+	table.sort(keys)
+	return keys
+end
+
+-- Benchmarks (first callback, outside the timer) ----------------------------
+local function bench()
+	local parts = {"GRUG_MGPROF_BENCH"}
+	-- A tight loop shaped like the P8 host scan (array reads, a small local
+	-- call, a compare): its ns per iteration tells a healthy JIT from a
+	-- starved or interpreted one.
+	local data = {}
+	for index = 1, 262144 do data[index] = index % 7 end
+	local function eligible(value, host) return value == host end
+	local t0, found = now(), 0
+	for _ = 1, 8 do
+		for index = 1, 262144 do
+			if eligible(data[index], 3) then found = found + 1 end
+		end
+	end
+	parts[#parts + 1] = ("loop_ns=%.2f"):format((now() - t0) * 1000 / (8 * 262144))
+	parts[#parts + 1] = "loop_found=" .. found
+	local raw = P.raw_sha256 or core.sha256
+	for _, length in ipairs({48, 96, 192}) do
+		local text = string.rep("x", length)
+		local n = 20000
+		t0 = now()
+		for index = 1, n do raw(text .. index, true) end
+		parts[#parts + 1] = ("sha%d_us=%.3f"):format(length, (now() - t0) / n)
+	end
+	local ok, hash = pcall(function()
+		return dofile(core.get_modpath("grug_mapgen") .. "/wp40/r6_hash.lua")(
+			function(bytes) return raw(bytes, true) end)
+	end)
+	if ok then
+		local seed = "15140735923413111218"
+		for _, count in ipairs({4, 7, 11}) do
+			local fields = {}
+			for index = 1, count do fields[index] = index * 37 - 500 end
+			fields[1] = "iron"
+			local n = 20000
+			t0 = now()
+			for index = 1, n do
+				fields[2] = index
+				hash.digest_count("resource_frontier_rank_v1", seed, fields, count)
+			end
+			parts[#parts + 1] = ("r6digest%d_us=%.3f"):format(count, (now() - t0) / n)
+		end
+	end
+	-- An integer stand-in for one 11-field digest: a 32-bit multiply/xorshift
+	-- mix per field with the bit library (what a replacement could cost).
+	local bit_api = rawget(_G, "bit")
+	if type(bit_api) == "table" then
+		local bxor, rshift, tobit = bit_api.bxor, bit_api.rshift, bit_api.tobit
+		local function mix(h, v)
+			h = tobit(bxor(h, v) * 0x01000193)
+			return bxor(h, rshift(h, 15))
+		end
+		local n, acc = 200000, 0
+		t0 = now()
+		for index = 1, n do
+			local h = 0x2545F491
+			h = mix(h, 77) h = mix(h, index) h = mix(h, -63) h = mix(h, -145)
+			h = mix(h, 5) h = mix(h, 2) h = mix(h, 0) h = mix(h, 7)
+			h = mix(h, 360) h = mix(h, -1001) h = mix(h, -2300)
+			acc = bxor(acc, h)
+		end
+		parts[#parts + 1] = ("int11_us=%.4f"):format((now() - t0) / n)
+		parts[#parts + 1] = "int11_acc=" .. acc
+	end
+	if jit_api and type(jit_api.status) == "function" then
+		local status = {jit_api.status()}
+		for index = 1, #status do status[index] = tostring(status[index]) end
+		parts[#parts + 1] = "jit_status=" .. table.concat(status, ","):gsub(" ", "_")
+		parts[#parts + 1] = "jit_version=" .. tostring(jit_api.version):gsub(" ", "_")
+	end
+	core.log("action", table.concat(parts, " "))
+end
+
+function P.begin()
+	if totals_only == nil then
+		totals_only = core.settings:get_bool("grug_mgprof_totals_only", false)
+		P.stages_on = not totals_only
+		if P.stages_on then pcall(bench) end
+	end
+	for key, value in pairs(trace) do trace_before[key] = value end
+	for key, value in pairs(abort_reason) do abort_reason_before[key] = value end
+	for key, value in pairs(abort_where) do abort_where_before[key] = value end
+	heap_before = collectgarbage("count")
+	stages, order, sub, counts, hashes = {}, {}, {}, {}, {}
+	pending_calls, pending_us, pending_bytes = 0, 0, 0
+	cache_before[1], cache_before[2], cache_before[3] = cache_totals()
+	P.result = "none"
+	P.active = P.stages_on
+	started = now()
+	last = started
+end
+
+function P.mark(name)
+	if not P.active then return end
+	local t = now()
+	local value = stages[name]
+	if value == nil then
+		order[#order + 1] = name
+		value = 0
+	end
+	stages[name] = value + (t - last)
+	if pending_calls > 0 then
+		local h = hashes[name]
+		if not h then
+			h = {0, 0, 0}
+			hashes[name] = h
+		end
+		h[1], h[2], h[3] = h[1] + pending_calls, h[2] + pending_us, h[3] + pending_bytes
+		pending_calls, pending_us, pending_bytes = 0, 0, 0
+	end
+	last = t
+end
+
+function P.add(name, us)
+	if P.active then sub[name] = (sub[name] or 0) + us end
+end
+
+function P.count(name, n)
+	if P.active then counts[name] = (counts[name] or 0) + (n or 1) end
+end
+
+local function top(map, before, limit)
+	local rows = {}
+	for key, value in pairs(map) do
+		local delta = value - (before and before[key] or 0)
+		if delta > 0 then rows[#rows + 1] = {key, delta} end
+	end
+	table.sort(rows, function(a, b)
+		if a[2] ~= b[2] then return a[2] > b[2] end
+		return a[1] < b[1]
+	end)
+	local out = {}
+	for index = 1, math.min(limit, #rows) do
+		out[#out + 1] = rows[index][2] .. "x " .. rows[index][1]
+	end
+	return table.concat(out, " | ")
+end
+
+function P.finish(minp, maxp)
+	if P.active then P.mark("tail") else last = now() end
+	P.active = false
+	callbacks = callbacks + 1
+	local total = last - started
+	local hits, misses, evictions = cache_totals()
+	local parts = {"GRUG_MGPROF",
+		"mode=" .. (totals_only and "totals" or "stages"),
+		"n=" .. callbacks,
+		"minp=" .. minp.x .. "," .. minp.y .. "," .. minp.z,
+		"maxp=" .. maxp.x .. "," .. maxp.y .. "," .. maxp.z,
+		"result=" .. tostring(P.result),
+		"total_us=" .. total,
+		"cc_hits=" .. (hits - cache_before[1]),
+		"cc_misses=" .. (misses - cache_before[2]),
+		"cc_evictions=" .. (evictions - cache_before[3]),
+		"heap_kb=" .. math.floor(heap_before),
+		"heap_after_kb=" .. math.floor(collectgarbage("count"))}
+	if P.trace_attached then
+		for _, key in ipairs({"start", "stop", "abort", "flush"}) do
+			parts[#parts + 1] = "jit_" .. key .. "=" .. (trace[key] - trace_before[key])
+			parts[#parts + 1] = "jit_" .. key .. "_cum=" .. trace[key]
+		end
+		parts[#parts + 1] = "jit_mcode_kb=" .. math.floor(mcode_bytes / 1024)
+		parts[#parts + 1] = ("jit_mcode_span_mb=%.1f"):format(
+			mcode_max >= mcode_min and (mcode_max - mcode_min) / 1048576 or 0)
+		parts[#parts + 1] = ("jit_mcode_min=0x%x"):format(
+			mcode_min < math.huge and mcode_min or 0)
+		parts[#parts + 1] = "jit_on=" .. tostring((jit_api.status()))
+	end
+	for index = 1, #order do
+		parts[#parts + 1] = "s." .. order[index] .. "=" .. stages[order[index]]
+	end
+	local keys = sorted_keys(sub)
+	for index = 1, #keys do
+		parts[#parts + 1] = "u." .. keys[index] .. "=" .. sub[keys[index]]
+	end
+	keys = sorted_keys(counts)
+	for index = 1, #keys do
+		parts[#parts + 1] = "c." .. keys[index] .. "=" .. counts[keys[index]]
+	end
+	keys = sorted_keys(hashes)
+	for index = 1, #keys do
+		local h = hashes[keys[index]]
+		parts[#parts + 1] = "h." .. keys[index] .. "=" .. h[1] .. "/" .. h[2] .. "/" .. h[3]
+	end
+	core.log("action", table.concat(parts, " "))
+	if P.trace_attached then
+		-- the aborts of this callback, and every 10th callback the process's
+		core.log("action", "GRUG_MGPROF_JIT n=" .. callbacks .. " aborts: " ..
+			top(abort_where, abort_where_before, 8))
+		if callbacks % 10 == 0 or callbacks <= 2 then
+			core.log("action", "GRUG_MGPROF_JITCUM n=" .. callbacks .. " reasons: " ..
+				top(abort_reason, nil, 20) .. " || stops: " .. top(stop_kind, nil, 8) ..
+				" || where: " .. top(abort_where, nil, 25))
+		end
+	end
+end
+
+return P
