grudgelands-town-roster 1
# The templates and palettes the capital's code places (frozen in Round 56):
# the civic core's buildings and every district plot's.
town kezamba
race troll

palette town race=troll
palette basalt race=troll castle_paving=grug_decor:darkage_basalt_brick castle_wall=grug_decor:darkage_basalt castle_wall_slab=grug_decor:darkage_basalt_slab castle_wall_stair=grug_decor:darkage_basalt_stair wall=grug_decor:darkage_basalt wall_accent=grug_decor:darkage_basalt_brick
palette water race=troll water=default:river_water_source
palette basalt_water race=troll castle_paving=grug_decor:darkage_basalt_brick castle_wall=grug_decor:darkage_basalt castle_wall_slab=grug_decor:darkage_basalt_slab castle_wall_stair=grug_decor:darkage_basalt_stair wall=grug_decor:darkage_basalt wall_accent=grug_decor:darkage_basalt_brick water=default:river_water_source
palette vine race=troll fern=default:junglegrass grass_tuft=default:junglegrass
palette crop race=troll crop=default:papyrus crop_soil=grug_farming:soil

