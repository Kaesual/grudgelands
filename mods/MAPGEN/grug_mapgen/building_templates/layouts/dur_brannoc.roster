grudgelands-town-roster 1
# The templates and palettes the capital's code places (frozen in Round 56):
# the civic core's buildings and every district plot's.
town dur_brannoc
race dwarf

palette town race=dwarf
palette slate race=dwarf roof_ridge=grug_decor:darkage_slate_tile roof_slab=grug_decor:darkage_slate_tile_slab roof_stair=grug_decor:darkage_slate_tile_stair roof_stair_inner=grug_decor:darkage_slate_tile_stair_inner roof_stair_outer=grug_decor:darkage_slate_tile_stair_outer

