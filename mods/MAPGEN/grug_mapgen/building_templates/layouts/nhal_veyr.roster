grudgelands-town-roster 1
# The templates and palettes the capital's code places (frozen in Round 56):
# the civic core's buildings and every district plot's.
town nhal_veyr
race undead

palette town race=undead
palette crypt race=undead ceiling=grug_decor:castle_dungeon_stone floor=grug_decor:castle_pavement_brick wall=grug_decor:castle_dungeon_stone wall_accent=default:obsidianbrick
palette vault race=undead roof_ridge=default:stonebrick roof_slab=stairs:slab_stonebrick roof_stair=stairs:stair_stonebrick roof_stair_inner=stairs:stair_inner_stonebrick roof_stair_outer=stairs:stair_outer_stonebrick
palette crypt_vault race=undead ceiling=grug_decor:castle_dungeon_stone floor=grug_decor:castle_pavement_brick roof_ridge=default:stonebrick roof_slab=stairs:slab_stonebrick roof_stair=stairs:stair_stonebrick roof_stair_inner=stairs:stair_inner_stonebrick roof_stair_outer=stairs:stair_outer_stonebrick wall=grug_decor:castle_dungeon_stone wall_accent=default:obsidianbrick

