      "level": 9,
      "requires": [
        "sunscar_hunt_05"
      ],
      "title": "The Road to Borak Redgrass",
      "text": "You have outgrown our wells. Follow the road out of Sunscar to Redtusk Village and tell Borak Redgrass that Gara sends a hunter, not a mouth to feed.",
      "objectives": [
        {
          "type": "talk",
          "npc": "r14_orc_steward"
