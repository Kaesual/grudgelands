            "kitchen"
          ]
        }
      ]
    }
  ],
  "quests": [
    {
      "id": "sunscar_hunt_01",
      "line": "hunt",
      "giver": "r14_orc_elder",
      "turnin": "r14_orc_elder",
      "min_level": 1,
      "level": 2,
      "requires": [],
      "title": "Tusks at the Water Skins",
      "text": "By day Small Boars root through our water skins in the {name:wellfields}, {dir_of:sunscar:wellfields}. Kill eight. Their names are yellow, so they only fight once you hit them; hit them anyway.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "small_boar"
          ],
          "count": 8,
          "area": "kragmar_sunscar_flats/wellfields"
        }
      ],
      "rewards": {
        "weight": 3,
        "items": []
      },
      "lesson": "Yellow names are neutral single pulls.",
      "duration_min": 8
    },
    {
      "id": "sunscar_hunt_02",
      "line": "hunt",
      "giver": "r14_orc_elder",
      "turnin": "r14_orc_elder",
      "min_level": 2,
      "level": 2,
      "requires": [
        "sunscar_hunt_01"
      ],
      "title": "Rats Under the Hide Racks",
      "text": "When the sun goes down, Large Dust Rats crawl out of the same {name:wellfields} and chew our hides. Kill eight after dark, and mind that one squeaking rat brings its cousins.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "large_rat"
          ],
          "count": 8,
          "area": "kragmar_sunscar_flats/wellfields"
        }
      ],
      "rewards": {
        "weight": 3,
        "items": []
      },
      "lesson": "Night rosters differ from day ones; rats call nearby rats.",
      "duration_min": 8
    },
    {
      "id": "sunscar_hunt_03",
      "line": "hunt",
      "giver": "r14_orc_elder",
      "turnin": "r14_orc_elder",
      "min_level": 4,
      "level": 5,
      "requires": [
        "sunscar_hunt_02"
      ],
      "title": "Runners for the Long Fire",
      "text": "Young Plains Runners graze the {name:runner_plains} by day, {zone_area:runner_plains}. Bring down eight; the fire wants meat and the clan wants hunters who can catch something faster than a rat.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "young_plains_runner"
          ],
          "count": 8,
          "area": "kragmar_sunscar_flats/runner_plains"
        }
      ],
      "rewards": {
        "weight": 3,
        "items": []
      },
      "duration_min": 10
    },
