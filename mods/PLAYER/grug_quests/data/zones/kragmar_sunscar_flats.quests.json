      "level": 6,
      "requires": [
        "sunscar_hunt_03"
      ],
      "title": "The Thirsting Dead",
      "text": "At night Sluggish Sun-Dried Husks drag themselves out of the {name:saltflats} {dir_from_giver:saltflats}, still looking for water they no longer need. Put eight of them back in the salt. They are slow; do not be slower.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "sluggish_husk"
          ],
          "count": 8,
          "area": "kragmar_sunscar_flats/saltflats"
        }
      ],
      "rewards": {
        "weight": 3,
        "items": []
      },
      "duration_min": 10
    },
    {
      "id": "sunscar_hunt_05",
      "line": "hunt",
      "giver": "r14_orc_elder",
      "turnin": "r14_orc_elder",
      "min_level": 8,
      "level": 9,
      "requires": [
        "sunscar_hunt_04"
      ],
      "title": "Lastdrop's Thirst",
      "text": "Water thieves dig at our wells and camp {dir_from_giver:thieves_camp} in the {name:thieves_camp}. Kill six Confused Water Thieves and their chief, Lastdrop, who has stolen so much water he can no longer remember why. Then Sunscar drinks in peace.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "confused_bandit"
          ],
          "count": 6,
          "area": "kragmar_sunscar_flats/thieves_camp"
        },
        {
          "type": "kill",
          "roles": [
            "water_thief_chief"
          ],
          "count": 1
        }
      ],
      "rewards": {
        "weight": 4.5,
        "items": []
      },
      "lesson": "Camps hold several enemies; pull the edge, then the chief.",
      "duration_min": 15,
      "climax": true
    },
    {
