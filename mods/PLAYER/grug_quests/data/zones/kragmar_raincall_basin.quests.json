  "quests": [
    {
      "id": "raincall_rains_01",
      "line": "rains",
      "giver": "r14_troll_steward",
      "turnin": "r14_troll_steward",
      "min_level": 10,
      "level": 11,
      "requires": [
        "kapok_departure"
      ],
      "title": "Feet in the Rain Gardens",
      "text": "Welcome to the basin. Reed Tapirs wade through our rain gardens in the {name:rainwood} {zone_area:rainwood} by day, and a garden that has been sat on grows nothing. Drive off eight. Strangers have also been asking the farms for a rain tithe; nobody here ever agreed to one.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "reed_tapir"
          ],
          "count": 8,
          "area": "kragmar_raincall_basin/rainwood"
        }
      ],
      "rewards": {
        "weight": 4,
        "items": []
      },
      "duration_min": 10
    },
    {
      "id": "raincall_rains_02",
      "line": "rains",
      "giver": "r14_troll_steward",
      "turnin": "r14_troll_steward",
      "min_level": 11,
      "level": 12,
      "requires": [
        "raincall_rains_01"
      ],
      "title": "Fangs on the Footpath",
      "text": "After dark the Reed-Fang Vipers coil on the footpaths of the {name:rainwood}. Kill eight before somebody steps on one on the way home. Their venom is quick; carry something to drink.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "reed_fang_viper"
          ],
          "count": 8,
          "area": "kragmar_raincall_basin/rainwood"
        }
      ],
      "rewards": {
        "weight": 4,
        "items": []
      },
      "duration_min": 10
    },
    {
      "id": "raincall_rains_03",
      "line": "rains",
      "giver": "r14_troll_steward",
      "turnin": "r14_troll_steward",
      "min_level": 12,
      "level": 13,
      "requires": [
        "raincall_rains_02"
      ],
      "title": "Collectors of the Rain Tithe",
      "text": "The tithe collectors are Roadside Bandits who walk the {name:rainwood} at night among the vipers. Take six of them off the road. They say they collect for someone called Vek; I say the rain collects for nobody.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "quarrelsome_bandit"
          ],
          "count": 6,
          "area": "kragmar_raincall_basin/rainwood"
        }
      ],
      "rewards": {
        "weight": 4,
        "items": []
      },
      "duration_min": 10
    },
    {
      "id": "raincall_rains_04",
      "line": "rains",
      "giver": "r14_troll_steward",
      "turnin": "r14_troll_scout",
      "min_level": 13,
      "level": 14,
      "requires": [
        "raincall_rains_03"
      ],
      "title": "Word for the Outpost",
      "text": "Neshi Reedstep keeps watch at Raincall Outpost along the road. Tell her what you found on the footpaths; her scouts will want to know where those collectors go next.",
      "objectives": [
        {
          "type": "talk",
          "npc": "r14_troll_scout"
        }
      ],
      "rewards": {
        "weight": 1,
        "items": []
      },
      "duration_min": 6
    },
    {
      "id": "raincall_watch_01",
      "line": "watch",
      "giver": "r14_troll_scout",
      "turnin": "r14_troll_scout",
      "min_level": 14,
      "level": 15,
      "requires": [
        "raincall_rains_04"
      ],
      "title": "Cats in the Cloudwood",
      "text": "The collectors move through the {name:cloudwood} {zone_area:cloudwood}, and so do the Reed Jungle Lynxes that keep my scouts from following them. Kill eight lynxes there by day and open the trail again.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "reed_jungle_lynx"
          ],
          "count": 8,
          "area": "kragmar_raincall_basin/cloudwood"
        }
      ],
      "rewards": {
        "weight": 4.5,
        "items": []
      },
      "duration_min": 11
    },
    {
      "id": "raincall_watch_02",
      "line": "watch",
      "giver": "r14_troll_scout",
      "turnin": "r14_troll_scout",
      "min_level": 15,
      "level": 16,
      "requires": [
        "raincall_watch_01"
      ],
      "title": "Gnawers in the Night",
      "text": "At night the Kapok Gnawers come out in the same {name:cloudwood} and chew through every rope my scouts tie. Kill eight. A trail you cannot mark is a trail you cannot follow.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "mangy_rat"
          ],
          "count": 8,
          "area": "kragmar_raincall_basin/cloudwood"
        }
      ],
      "rewards": {
        "weight": 4.5,
        "items": []
      },
      "duration_min": 11
    },
    {
      "id": "raincall_watch_03",
      "line": "watch",
      "giver": "r14_troll_scout",
      "turnin": "r14_troll_scout",
      "min_level": 17,
      "level": 18,
      "requires": [
        "raincall_watch_02"
      ],
      "title": "Lookouts Over the Tithe",
      "text": "The trail ends at the {name:bandit_camp} {dir_from_giver:bandit_camp}. Bandit Lookouts guard it with bows; kill eight and do not stand still in the open while you do it.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "vigilant_bandit_archer"
          ],
          "count": 8,
          "area": "kragmar_raincall_basin/bandit_camp"
        }
      ],
      "rewards": {
        "weight": 4.5,
        "items": []
      },
      "lesson": "Archers keep their distance; close in or use cover.",
      "duration_min": 12
    },
    {
      "id": "raincall_watch_04",
      "line": "watch",
      "giver": "r14_troll_scout",
      "turnin": "r14_troll_captive",
      "min_level": 18,
      "level": 18,
      "requires": [
        "raincall_watch_03"
      ],
      "title": "The Prisoner at the Camp",
      "text": "My scouts saw a prisoner at that camp: Veko Bluefeather, who refused to pay the tithe. Go back and speak with Veko while the lookouts are thin.",
      "objectives": [
        {
          "type": "talk",
          "npc": "r14_troll_captive"
        }
      ],
      "rewards": {
        "weight": 1,
        "items": []
      },
      "duration_min": 5
    },
    {
      "id": "raincall_tithe_01",
      "line": "tithe",
      "giver": "r14_troll_captive",
      "turnin": "r14_troll_captive",
      "min_level": 18,
      "level": 19,
      "requires": [
        "raincall_watch_04"
      ],
      "title": "The Tithe-Keeper",
      "text": "Vek keeps the tithe and the keys, and counts both {dir_from_giver:tithe_keeper_vek}, in the middle of this camp. Settle Bandit Tithe-Keeper Vek and the basin pays its rain to nobody again. I will walk home on my own feet, thank you.",
      "objectives": [
        {
          "type": "kill",
          "roles": [
            "tithe_keeper_vek"
          ],
          "count": 1
        }
      ],
      "rewards": {
        "weight": 6,
        "items": []
      },
      "climax": true,
      "duration_min": 10
    },
    {
      "id": "raincall_departure",
      "line": "tithe",
      "giver": "r14_troll_captive",
      "turnin": "r20_troll_capital_envoy",
      "min_level": 19,
      "level": 19,
      "requires": [
        "raincall_tithe_01"
      ],
      "title": "Word for Kezamba",
      "text": "Kezamba should hear that the tithe is broken, and Nalo Pathdrum at the shrine is the one who listens. Take the road to the capital and tell Nalo; I will tell everyone else, loudly.",
      "objectives": [
        {
          "type": "talk",
          "npc": "r20_troll_capital_envoy"
        }
      ],
      "rewards": {
        "weight": 1.5,
        "items": []
      },
      "duration_min": 8
    },
    {
      "id": "raincall_weave_01",
      "line": "weave",
      "giver": "r15_troll_local",
      "turnin": "r15_troll_local",
      "min_level": 11,
      "level": 12,
      "requires": [
        "kapok_departure"
      ],
      "title": "Leather for the Rain Capes",
      "text": "Rain capes need Leather, and the Reed Tapirs of the {name:rainwood} wear plenty of it. Bring three. If you are already chasing them out of the gardens, two jobs walk the same path.",
      "objectives": [
        {
          "type": "item",
          "item": "mobs:leather",
          "count": 3,
          "roles": [
            "reed_tapir"
          ],
