        "items": []
      },
      "duration_min": 8
    },
    {
      "id": "raincall_weave_02",
      "line": "weave",
      "giver": "r15_troll_local",
      "turnin": "r15_troll_local",
      "min_level": 13,
      "level": 14,
      "requires": [
        "raincall_weave_01"
      ],
      "title": "Iron for the Stilts",
      "text": "The stilt houses lean when the water rises. Bring four Iron Bars and four Coal Lumps so the smith can make brackets that do not bend.",
      "objectives": [
        {
          "type": "item",
          "item": "grug_materials:iron_bar",
          "count": 4
        },
        {
          "type": "item",
          "item": "default:coal_lump",
          "count": 4
        }
      ],
      "rewards": {
        "weight": 3,
        "items": []
      },
      "lesson": "Iron is the second tier of ore.",
      "duration_min": 12
    },
    {
      "id": "raincall_weave_03",
      "line": "weave",
      "giver": "r15_troll_local",
      "turnin": "r15_troll_local",
      "min_level": 15,
      "level": 16,
      "requires": [
        "raincall_weave_02"
      ],
      "title": "Claws for the Weavers",
      "text": "My weavers comb palm fibre with cat claws; nothing else gets the knots out. Bring two Hooked Cat Claws from the Reed Jungle Lynxes of the {name:cloudwood}.",
      "objectives": [
        {
          "type": "item",
          "item": "grug_mobs:hooked_cat_claw",
          "count": 2,
          "roles": [
            "reed_jungle_lynx"
          ],
          "area": "kragmar_raincall_basin/cloudwood"
        }
      ],
      "rewards": {
