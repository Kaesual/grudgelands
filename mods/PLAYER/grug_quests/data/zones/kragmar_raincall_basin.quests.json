      },
      "duration_min": 8
    },
    {
      "id": "raincall_weave_04",
      "line": "weave",
      "giver": "r15_troll_local",
      "turnin": "r15_troll_local",
      "min_level": 17,
      "level": 18,
      "requires": [
        "raincall_weave_03"
      ],
      "title": "Linen from the Lookouts",
      "text": "The tithe men wear better linen than the people they rob. Bring three Linen Cloth from the Bandit Lookouts at the {name:bandit_camp}; if Neshi sends you there anyway, take the cloth while you are at it.",
      "objectives": [
        {
